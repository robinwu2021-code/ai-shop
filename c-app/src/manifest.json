{
  "name": "社区好物",
  "appid": "",
  "description": "社区电商 C 端",
  "versionName": "0.1.32",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "distribute": {
      "//packagename": "三端同一个标识（安卓包名 / iOS BundleId / 鸿蒙 bundleName）。上架后不可改",
      "//待定": "C 端的发布标识未定（B 端是 top.hxmall.bapp）。注意这与 Java 包名 ai.neargo.shop.* 是两件事，后者不动 —— 见《App签名与打包参数》§1",
      "android": { "permissions": [] },
      "ios": {},
      "sdkConfigs": {
        "//push": "ADR-018：推送走 uni-push 2.0，底座就是个推，端上不写一行原生代码。",
        "//offline": "false = 只用在线通道；厂商通道在 uni-push 控制台配好后改 true，后端零改动。",
        "push": { "unipush": { "version": "2", "offline": false } }
      }
    }
  },
  "mp-weixin": {
    "appid": "wx3201250c28393850",
    "setting": { "urlCheck": false, "minified": true },
    "usingComponents": true,
    /* 调用点传给组件的 class **要落到组件根上**，不能只落在宿主节点上。
       两端的节点树形状不同：H5 里 `<script setup>` 组件没有宿主，`<sh-cover class="hero__emoji">`
       编译出来就是它自己的根，页面那条 `.hero__emoji { width/height/border-radius }` 直接生效；
       小程序里宿主是**真节点**，class 停在宿主上，组件根一条都吃不到 ——
       于是全站 13 个封面在小程序上**尺寸由 image 的默认值决定、圆角丢失**，
       而 H5 与原型上都是对的。这一个开关让两端一致（编译产物里可以看到组件根变成
       `class="{{['cover','data-v-…', virtualHostClass]}}"`）。
       ⚠️ 代价：class 会**同时**留在宿主上。所以调用点不要再往组件上挂
       padding / border —— 那会被吃两遍。2026-09-06 打开时把两端 5 处这样的覆盖撤了。 */
    "mergeVirtualHostAttributes": true,
    "permission": {
      "scope.userLocation": {
        "desc": "用于查找附近的社区自提点"
      }
    },
    /* 涉隐私接口要**逐个声明**，漏一个那个接口在真机上直接失败（模拟器不拦，看不出来）。
       ⚠️ **反过来也不行：还没获批的接口不许写进来。**
       2026-09-03 把尚未申请的 getFuzzyLocation 写进这个数组，结果整个小程序
       在启动阶段卡死 —— 不是报错，是**没有任何响应**：automator 连得上、
       currentPage 却永远不返回，重启工具、重开项目都一样。
       查了四轮才落到这一行。**声明与获批必须同时成立，缺哪一半都是坏的。**
       所以顺序是：先在后台申请通过，再往这里加。
       两个都要在后台「开发管理 → 接口设置」单独申请开通，声明与申请缺一不可：
       · getLocation    选社区自提点时按距离排序
       · chooseLocation 收货地址页在地图上选点
       openLocation（导航到自提点）不在受限名单里，不用声明也不用申请。 */
    "requiredPrivateInfos": ["getLocation", "chooseLocation", "chooseAddress"]
  },
  "h5": {
    "router": { "mode": "hash" },
    "//rpx": "rpx 的换算基准不在这里 —— uni 运行时读的是 pages.json 的 globalStyle（见那里的 rpxCalcMaxDeviceWidth）"
  },
  "vueVersion": "3"
}
