{
  "name": "ai-shop-c-app",
  "version": "0.1.0",
  "description": "ai-shop C 端（社区电商 · 微信小程序优先 · Android/iOS 次之）",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin && node scripts/mp-private-config.mjs",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit",
    "gen:api": "node scripts/gen-openapi.mjs",
    "upload:mp": "node scripts/upload-mp.mjs",
    "release:mp": "bash scripts/release-mp.sh",
    "test": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@ai-shop/ui": "*",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/runtime-core": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.0",
    "happy-dom": "^20.11.6",
    "miniprogram-automator": "^0.12.1",
    "miniprogram-ci": "^2.1.31",
    "sass": "^1.102.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.9.3",
    "unocss": "66.7.5",
    "unocss-applet": "^0.13.8",
    "vite": "5.2.8",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=22"
  }
}
