{
  "openapi": "3.1.0",
  "info": {
    "title": "V45 Account Entity Material API",
    "version": "0.1.0-development",
    "description": "Account USR owner scope, no selected store required. Existing singular /biz/entity/{entityNo} remains compatible. New endpoints require shop.pay.entity-profiles.enabled and near-pay.entity-profiles.enabled; private live App adapter requires ENTITY_WORKSPACE_LIVE. Channel selection acceptance is not channel submission or collection eligibility. Schema currently TW company/business workspace; channel legal-form mappings remain independently validated."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/biz/entities/{entityNo}/profile-template": {
      "get": {
        "operationId": "getEntityprofile_template",
        "summary": "Entity material template",
        "parameters": [
          {
            "name": "entityNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Standard shop success envelope; authorization and business errors use existing shop error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/biz/entities/{entityNo}/profile-draft": {
