    "/biz/entities/{entityNo}/commands/{requestNo}": {
      "get": {
        "operationId": "getEntitycommandsResult",
        "summary": "Recover original command",
        "parameters": [
          {
            "name": "entityNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          },
          {
            "name": "requestNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Standard shop success envelope; authorization and business errors use existing shop error codes.",
