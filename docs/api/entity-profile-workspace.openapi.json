            }
          }
        }
      }
    },
    "/biz/entities/{entityNo}/files": {
      "post": {
        "summary": "Upload private entity evidence, not a public image",
        "parameters": [
          {
            "name": "entityNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "requestNo",
                  "purpose",
                  "file"
                ],
                "properties": {
                  "requestNo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "maxLength": 5242880
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard shop success envelope; authorization and business errors use existing shop error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/FileReceipt"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/biz/entities": {
      "post": {
        "summary": "Create entity without store or approval; optional safe profile initialization has independent recovery state",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestNo",
                  "name"
                ],
                "properties": {
                  "requestNo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "legalForm": {
                    "type": "string",
                    "enum": [
                      "ENTERPRISE",
                      "INDIVIDUAL",
                      "NATURAL_PERSON"
                    ],
                    "description": "ENTERPRISE company, INDIVIDUAL registered sole trader (has a tax number), NATURAL_PERSON the applicant themselves (name at most 20 characters, no tax number)"
                  },
                  "profileFields": {
                    "$ref": "#/components/schemas/InitialProfile"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard shop success envelope; authorization and business errors use existing shop error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Creation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/biz/entities/create-results/{requestNo}": {
      "get": {
        "summary": "Recover entity creation and actual PAY initialization outcome; PENDING/UNKNOWN is not completion",
        "parameters": [
          {
            "name": "requestNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Standard shop success envelope; authorization and business errors use existing shop error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Creation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/biz/entities/{entityNo}/contact": {
      "post": {
        "summary": "Save the entity contact outside material revisions (V46); ACCOUNT name and mobile come from the owner account",
        "parameters": [
          {
            "name": "entityNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      }
    },
    "/biz/entities/{entityNo}/revision-discards": {
      "post": {
        "summary": "Discard a revision draft (DRAFT, rejected or sync failed); refused while under review or unknown",
        "parameters": [
          {
            "name": "entityNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      }
    },
    "/biz/entities/{entityNo}/files/{fileId}/preview": {
      "get": {
        "summary": "Owner-only thumbnail of an uploaded evidence file; no-store",
        "parameters": [
          {
            "name": "entityNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "The 32 hex characters of file:entity-profile/<id>",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG thumbnail",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "204": {
            "description": "No thumbnail (for example a PDF)"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "EntityFields": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 512
          },
          "legalForm": {
            "type": "string",
            "maxLength": 512
          },
          "taxNo": {
            "type": "string",
            "maxLength": 512
          },
          "incorporationDate": {
            "type": "string",
            "maxLength": 512
          },
          "capitalAmount": {
            "type": "string",
            "maxLength": 512
          },
          "registeredAddress": {
            "type": "string",
            "maxLength": 512
          },
          "companyPhone": {
            "type": "string",
            "maxLength": 512
          },
          "representativeKind": {
            "type": "string",
            "maxLength": 512
          },
          "arcResidenceType": {
            "type": "string",
            "maxLength": 512
          },
          "idIssueType": {
            "type": "string",
            "maxLength": 512
          },
          "representativeName": {
            "type": "string",
            "maxLength": 512
          },
          "identityNo": {
            "type": "string",
            "maxLength": 512
          },
          "nationality": {
            "type": "string",
            "maxLength": 512
          },
          "birthDate": {
            "type": "string",
            "maxLength": 512
          },
          "issueDate": {
            "type": "string",
            "maxLength": 512
          },
          "expiryDate": {
            "type": "string",
            "maxLength": 512
          },
          "issuePlace": {
            "type": "string",
            "maxLength": 512
          },
          "arcBackNo": {
            "type": "string",
            "maxLength": 512
          },
          "corporateTaxNo": {
            "type": "string",
            "maxLength": 512
          },
          "corporateName": {
            "type": "string",
            "maxLength": 512
          },
          "corporateAddress": {
            "type": "string",
            "maxLength": 512
          },
          "corporateCapital": {
            "type": "string",
            "maxLength": 512
          },
          "contactName": {
            "type": "string",
            "maxLength": 512
          },
          "contactMobile": {
            "type": "string",
            "maxLength": 512
          },
          "contactEmail": {
            "type": "string",
            "maxLength": 512
          },
          "contactAddress": {
            "type": "string",
            "maxLength": 512
          },
          "disputeEmail": {
            "type": "string",
            "maxLength": 512
          },
          "businessName": {
            "type": "string",
            "maxLength": 512
          },
          "industry": {
            "type": "string",
            "maxLength": 512
          },
          "businessDescription": {
            "type": "string",
            "maxLength": 512
          },
          "businessAddress": {
            "type": "string",
            "maxLength": 512
          },
          "website": {
            "type": "string",
            "maxLength": 512
          },
          "bankCode": {
            "type": "string",
            "maxLength": 512
          },
          "branchCode": {
            "type": "string",
            "maxLength": 512
          },
          "accountName": {
            "type": "string",
            "maxLength": 512
          },
          "bankAccount": {
            "type": "string",
            "maxLength": 512
          },
          "beneficiaryRelation": {
            "type": "string",
            "maxLength": 512
          },
          "beneficiaryCount": {
            "type": "string",
            "maxLength": 512
          }
        },
        "patternProperties": {
          "^beneficiary\\.[0-9]\\.(name|nationality|birthDate|identityNo|relationship)$": {
            "type": "string",
            "maxLength": 512
          }
        },
        "additionalProperties": false,
        "x-sensitive": "No plaintext persistence in device journal, analytics, logs or ordinary relational columns."
      },
      "Command": {
        "type": "object",
        "required": [
          "requestNo",
          "expectedVersion",
          "schemaVersion"
        ],
        "properties": {
          "requestNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "schemaVersion": {
            "enum": [
              "TW_ENTITY_1",
              "TW_ENTITY_2"
            ]
          },
          "fields": {
            "$ref": "#/components/schemas/EntityFields"
          },
          "documents": {
            "type": "object",
            "maxProperties": 30,
            "additionalProperties": {
              "type": "string",
              "pattern": "^file:entity-profile/[a-f0-9]{32}$"
            }
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "NEWEBPAY",
                "LINEPAY",
                "JKOPAY"
              ]
            }
          },
          "consentVersion": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          },
          "channelMaterials": {
            "type": "object",
            "maxProperties": 3,
            "propertyNames": {
              "enum": [
                "NEWEBPAY",
                "LINEPAY",
                "JKOPAY"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "maxProperties": 20,
              "additionalProperties": {
                "type": "string",
                "maxLength": 512
              }
            },
            "description": "Channel supplements (Newebpay: merchantName, mcType, merchantType, merchantNameEn, merchantAddressEn, managerNameEn, serviceEmail, methods); frozen with the submission"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "entityNo",
          "version",
          "schemaVersion",
          "fields",
          "documents",
          "platformReview",
          "allowedActions",
          "missingFields"
        ],
        "properties": {
          "entityNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "version": {
            "type": "integer"
          },
          "schemaVersion": {
            "type": "string"
          },
          "fields": {
            "$ref": "#/components/schemas/EntityFields"
          },
          "documents": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "platformReview": {
            "enum": [
              "NONE",
              "REVIEWING",
              "APPROVED",
              "REJECTED",
              "SUPPLEMENT_REQUIRED",
              "SUPERSEDED"
            ]
          },
          "approvedVersion": {
            "type": [
              "integer",
              "null"
            ]
          },
          "merchantNo": {
            "type": [
              "string",
              "null"
            ],
            "description": "PAY platform merchant number, only disclosed after approval; never alias entityNo."
          },
          "channels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "enum": [
                "EDIT",
                "UPLOAD",
                "SUBMIT",
                "CREATE_REVISION",
                "REQUEST_CHANNEL"
              ]
            }
          },
          "missingFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supplementFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supplementDocuments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channelOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelOption"
            }
          },
          "consentVersion": {
            "type": "string"
          },
          "consentText": {
            "type": "string"
          },
          "submittedRevisionNo": {
            "type": [
              "string",
              "null"
            ]
          },
          "submittedProfileVersion": {
            "type": [
              "integer",
              "null"
            ]
          },
          "revisionState": {
            "enum": [
              "DRAFT",
              "PLATFORM_REVIEWING",
              "PLATFORM_REJECTED",
              "PLATFORM_APPROVED",
              "CHANNEL_SYNCING",
              "SYNC_FAILED",
              "EFFECTIVE",
              "DISCARDED"
            ],
            "description": "Layer A (PAY V46); clients derive it from platformReview when absent"
          },
          "effectiveRevisionNo": {
            "type": [
              "string",
              "null"
            ]
          },
          "contactVersion": {
            "type": [
              "integer",
              "null"
            ]
          },
          "channelMaterials": {
            "type": "object",
            "maxProperties": 3,
            "propertyNames": {
              "enum": [
                "NEWEBPAY",
                "LINEPAY",
                "JKOPAY"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "maxProperties": 20,
              "additionalProperties": {
                "type": "string",
                "maxLength": 512
              }
            },
            "description": "Channel supplements (Newebpay: merchantName, mcType, merchantType, merchantNameEn, merchantAddressEn, managerNameEn, serviceEmail, methods); frozen with the submission"
          },
