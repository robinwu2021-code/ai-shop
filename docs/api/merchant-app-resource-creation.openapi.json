          }
        ],
        "responses": {
          "200": {
            "description": "Read envelope code; only code=0 is success. Validation/permission/not-found/conflict errors follow the existing PortalResponse contract.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MerchantProfileOverview"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitMerchantProfile",
        "security": [
