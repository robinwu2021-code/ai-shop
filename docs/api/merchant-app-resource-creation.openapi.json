  "components": {
    "securitySchemes": {
      "merchantBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateOperatingEntity": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "market": {
            "type": "string",
            "enum": [
              "CN",
              "TW",
              "AE"
            ]
          },
          "legalSubjectId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        },
        "required": [
          "name",
          "market"
        ]
      },
      "OperatingEntity": {
        "type": "object",
        "properties": {
          "operatingEntityId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string"
          },
          "market": {
            "type": "string",
            "enum": [
              "CN",
              "TW",
              "AE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ]
          },
          "version": {
            "type": "integer"
          },
          "legalSubjectId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "operatingEntity.read"
              ]
            }
          }
        },
        "required": [
          "operatingEntityId",
          "name",
          "market",
          "status",
          "version",
          "legalSubjectId",
          "allowedActions"
        ]
      },
      "LegalSubject": {
        "type": "object",
        "properties": {
          "legalSubjectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string"
          },
          "market": {
            "type": "string",
            "enum": [
              "CN",
              "TW",
              "AE"
            ]
          },
          "legalForm": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "version": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          "verified": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "legalSubjectId",
          "name",
          "market",
          "version",
          "status",
          "verified"
        ]
      },
      "CreatePaymentMerchant": {
        "type": "object",
        "properties": {
          "requestNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "operatingEntityId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "requestNo",
          "operatingEntityId",
          "name"
        ]
      },
      "PaymentMerchantCreation": {
        "type": "object",
        "properties": {
          "merchantNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "operatingEntityId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string"
          },
          "market": {
            "type": "string",
            "enum": [
              "CN",
              "TW",
              "AE"
            ]
          },
          "status": {
            "type": "string"
          },
          "membershipNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "role": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "merchantNo",
          "operatingEntityId",
          "name",
          "market",
          "status",
          "membershipNo",
          "role",
          "actions"
        ]
      },
      "MerchantProfileSubmission": {
        "type": "object",
        "required": [
          "requestNo",
          "expectedRevision",
          "legalName"
        ],
        "properties": {
          "requestNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "legalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "registrationNo": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "registeredAddress": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "representativeName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "contactPhone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "industry": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        },
        "description": "Independent PM only. Server fixes purpose=FIAT. No material references, actor, tenant or merchant in the body. Optional sensitive values are masked before persistence."
      },
      "MerchantProfileRevision": {
        "type": "object",
        "required": [
          "revisionNo",
          "revision",
          "purpose",
          "reviewStatus",
          "profile",
          "version"
        ],
        "properties": {
          "revisionNo": {
            "type": "string",
            "maxLength": 80
          },
          "revision": {
            "type": "integer"
          },
          "purpose": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "APPROVED",
              "REJECTED",
              "NEED_MORE",
              "SUPERSEDED"
            ]
          },
          "profile": {
            "type": "object",
            "properties": {
              "legalName": {
                "type": "string"
              },
              "registrationNoMasked": {
                "type": "string"
              },
              "registeredAddress": {
                "type": "string"
              },
              "representativeMasked": {
                "type": "string"
              },
              "contactMasked": {
                "type": "string"
              },
              "industry": {
                "type": "string"
              }
            }
          },
          "reviewReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "MerchantProfileOverview": {
        "type": "object",
        "required": [
          "revision",
          "canSubmit",
          "approvedRevisionNo",
          "items"
        ],
        "properties": {
          "revision": {
            "type": "integer"
          },
          "canSubmit": {
            "type": "boolean"
          },
          "approvedRevisionNo": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MerchantProfileRevision"
            }
          }
        }
      }
    }
  }
}
