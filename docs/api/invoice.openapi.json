{
  "openapi": "3.0.3",
  "info": {
    "title": "发票 B 端接口（ADR-063）",
    "version": "1.0.0",
    "description": "多行业发票开立与台湾电子发票证明联。设计见 docs/technical/TDD-发票模块.md。证明联打印与补印走打印中心 /biz/print/requests（来源类型 INVOICE、场景 INVOICE_PROOF）。 C 端 /mp 部分见 TDD §8（载具优先）。"
  },
  "paths": {
    "/biz/invoices": {
      "post": {
        "summary": "按来源单开票（同来源返回原发票）",
        "description": "权限 `biz:invoice:issue`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVO"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueInvoiceReq"
              }
            }
          }
        }
      },
      "get": {
        "summary": "本店发票分页",
        "description": "权限 `biz:invoice:read`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "periodCode",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "[0-9]{5}"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ISSUED",
                "VOIDED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoicePage"
                }
              }
            }
          }
        }
      }
    },
    "/biz/invoices/{invoiceNo}": {
      "get": {
        "summary": "发票详情（明细、上传状态、折让）",
        "description": "权限 `biz:invoice:read`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVO"
                }
              }
            }
          }
        }
      }
    },
    "/biz/invoices/{invoiceNo}/void": {
      "post": {
        "summary": "当期作废",
        "description": "权限 `biz:invoice:void`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVO"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "作废原因"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    "/biz/invoices/{invoiceNo}/allowances": {
      "post": {
        "summary": "开折让",
        "description": "权限 `biz:invoice:void`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVO"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amountMinor": {
                    "type": "integer",
                    "format": "int64",
                    "description": "含税折让金额（最小货币单位）"
                  },
                  "reason": {
                    "type": "string",
                    "description": "折让原因"
                  }
                },
                "required": [
                  "amountMinor",
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    "/biz/invoice-setup/profile": {
      "get": {
        "summary": "本主体税制配置",
        "description": "权限 `biz:invoice:setup`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegimeProfileVO"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "开通 / 修改税制",
        "description": "权限 `biz:invoice:setup`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegimeProfileVO"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "regimeCode": {
                    "type": "string",
                    "description": "税制，首期 TW_EGUI"
                  },
                  "sellerTaxId": {
                    "type": "string",
                    "description": "卖方统一编号"
                  },
                  "sellerName": {
                    "type": "string",
                    "description": "营业人名称"
                  },
                  "gatewayCode": {
                    "type": "string",
                    "description": "开票通道：STUB 模拟 / TURNKEY 财政部 Turnkey / CETUSTEK 鲸跃加值中心"
                  },
                  "qrAesKeyHex": {
                    "type": "string",
                    "description": "财政部 QR 加密 AES Key（32 位十六进制），只写不读"
                  },
                  "memberCarrierType": {
                    "type": "string",
                    "description": "会员载具类别号"
                  },
                  "autoIssue": {
                    "type": "boolean",
                    "description": "付款成功后按预存买受人自动开立；不传 = 关"
                  },
                  "providerAccountCode": {
                    "type": "string",
                    "description": "加值中心分给商家的代号（鲸跃 officeid）；不传 = 清空"
                  },
                  "providerUser": {
                    "type": "string",
                    "description": "加值中心账号（鲸跃 posno），只写不读；与 providerPassword 同传才更新"
                  },
                  "providerPassword": {
                    "type": "string",
                    "description": "加值中心密码（鲸跃 posid），只写不读，进 secret 模块"
                  },
                  "rangeLowWater": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000,
                    "description": "本期剩余号码提醒值；不传 = 不改（新开通默认 50）"
                  },
                  "autoFetchRanges": {
                    "type": "boolean",
                    "description": "余量不足 / 期末前自动向加值中心领号；不传 = 不改；只对服务商配号的通道（鲸跃）生效"
                  }
                },
                "required": [
                  "regimeCode",
                  "sellerTaxId",
                  "sellerName",
                  "gatewayCode"
                ]
              }
            }
          }
        }
      }
    },
    "/biz/invoice-setup/ranges": {
      "get": {
        "summary": "字轨号段",
        "description": "权限 `biz:invoice:setup`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "periodCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NumberRangeVO"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "登记字轨号段",
        "description": "权限 `biz:invoice:setup`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NumberRangeVO"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "regimeCode": {
                    "type": "string",
                    "description": "税制"
                  },
                  "periodCode": {
                    "type": "string",
                    "description": "期别，如 11512"
                  },
                  "track": {
                    "type": "string",
                    "description": "字轨两字母"
                  },
                  "startNo": {
                    "type": "integer"
                  },
                  "endNo": {
                    "type": "integer"
                  },
                  "storeNo": {
                    "type": "string",
                    "description": "空 = 主体内各店共用"
                  }
                },
                "required": [
                  "regimeCode",
                  "periodCode",
                  "track",
                  "startNo",
                  "endNo"
                ]
              }
            }
          }
        }
      }
    },
    "/biz/invoices/buyer-preferences": {
      "put": {
        "summary": "付款前预存买受人（载具 / 统编 / 捐赠），自动开立时使用",
        "description": "权限 `biz:invoice:issue`；门店取 `X-Store-No`，主体取登录上下文。按主体税制校验，同一来源以最后一次为准。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sourceType",
                  "sourceNo",
                  "buyer"
                ],
                "properties": {
                  "sourceType": {
                    "type": "string",
                    "description": "来源类型，SUB_ORDER"
                  },
                  "sourceNo": {
                    "type": "string",
                    "description": "来源单号"
                  },
                  "buyer": {
                    "type": "object",
                    "properties": {
                      "taxId": {
                        "type": "string",
                        "description": "买方统编（打统编）"
                      },
                      "name": {
                        "type": "string",
                        "description": "买方名称"
                      },
                      "carrierType": {
                        "type": "string",
                        "description": "载具类别：3J0002 手机条码 / CQ0001 自然人凭证 / 会员载具"
                      },
                      "carrierId": {
                        "type": "string",
                        "description": "载具号码"
                      },
                      "donateCode": {
                        "type": "string",
                        "description": "爱心码"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应包，data 为空"
          }
        }
      }
    },
    "/mp/invoice-carrier": {
      "get": {
        "summary": "我的常用载具",
        "description": "要登录；买家身份只取登录态，入参不收用户号。",
