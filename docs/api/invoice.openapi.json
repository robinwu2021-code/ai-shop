                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CarrierVO"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "保存常用载具（第一个或 makeDefault 成为默认）",
        "description": "要登录；买家身份只取登录态，入参不收用户号。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarrierVO"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
