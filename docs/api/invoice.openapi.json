    },
    "/mp/sales-invoice/{invoiceNo}": {
      "get": {
        "summary": "我的发票详情",
        "description": "要登录；买家身份只取登录态，入参不收用户号。",
        "parameters": [
          {
            "name": "invoiceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVO"
                }
              }
            }
          }
        }
      }
    },
    "/biz/invoice-setup/provider-verification": {
      "post": {
        "summary": "核验加值中心账号",
        "description": "权限 `biz:invoice:setup`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。 用已保存的账号查询服务商侧营业人资料，统编须一致；服务商回了 QR 金钥即存入 secret 模块。 服务商拒绝时回 26011（参数为服务商原文代码，如 invalid / exist）；主体通道不是加值中心时回 26008。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderVerificationVO"
                }
              }
            }
          }
        }
      }
    },
    "/biz/invoice-setup/provider-ranges": {
      "post": {
        "summary": "向加值中心取字轨号段",
        "description": "权限 `biz:invoice:setup`；门店取 `X-Store-No`，主体取登录上下文，入参不接受主体号。 申请并取回一段号码入库（allocationOwner=PROVIDER，主体内各店共用）；同一段重复取回只入库一次。 服务商拒绝时回 26011（参数为服务商原文代码，如 invalid / exist）；主体通道不是加值中心时回 26008。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "periodCode": {
                    "type": "string",
                    "description": "期别（5 位，如 11512）；不传 = 当期"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NumberRangeVO"
                }
              }
            }
          }
        }
      }
    },
    "/biz/invoices/{invoiceNo}/retransmissions": {
      "post": {
        "summary": "重传待人工处理的上传",
        "description": "权限 `biz:invoice:issue`；门店取 `X-Store-No`。把这张发票（含其折让）状态为 NEEDS_REVIEW 的上传任务放回待发，报文不变原样再发；没有可重传的任务回 26008。账号问题造成的 HELD 不走这里 —— 核验账号通过即自动恢复。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVO"
                }
              }
            }
          }
        }
      }
    },
    "/biz/invoices/{invoiceNo}/allowances/{allowanceNo}/void": {
      "post": {
        "summary": "作废折让",
        "description": "权限 `biz:invoice:void`；门店取 `X-Store-No`。只能作废本期折让（跨期回 26006）；已作废回 26008；折让不属于该发票回 26005。作废后累计折让回退（全部折让作废后发票本身可作废），折让证明单不再出纸，生成 G0501 上传任务（鲸跃 UploadCancelAllowance）。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "allowanceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "内部折让单号"
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVO"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "作废原因"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    "/biz/invoices/upload-backlog": {
      "get": {
        "summary": "本门店上传积压",
        "description": "权限 `biz:invoice:read`；门店取 `X-Store-No`。列表页顶部提示用：逾期、即将到期、暂停、待人工的条数（含开立、作废、折让、作废折让的上传任务）。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadBacklogVO"
                }
              }
            }
          }
        }
      }
    },
    "/biz/invoices/{invoiceNo}/provider-checks": {
      "post": {
        "summary": "向服务商查单并对账",
        "description": "权限 `biz:invoice:issue`；门店取 `X-Store-No`。调鲸跃 QueryInvoiceStatus：服务商已有这张票而本地开立上传未标送达的补记为已送达，服务商已作废而本地作废上传未标送达的同样补记；与本地不一致且无待补传任务时告警 INVOICE_PROVIDER_MISMATCH。通道不是加值中心类回 26008，服务商拒绝 / 不可达回 26011（参数为原文代码）。",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCheckVO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
