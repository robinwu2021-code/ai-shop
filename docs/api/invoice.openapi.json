    "/mp/invoice-carrier/{carrierNo}/delete": {
      "post": {
        "summary": "删除常用载具",
        "description": "要登录；买家身份只取登录态，入参不收用户号。",
        "parameters": [
          {
            "name": "carrierNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/mp/sales-invoice/choice": {
      "put": {
        "summary": "给自己的订单选发票开法",
        "description": "要登录；买家身份只取登录态，入参不收用户号。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "统一响应包 data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChoiceResultVO"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orderNo",
                  "kind"
                ],
                "properties": {
                  "orderNo": {
                    "type": "string",
                    "description": "主订单号"
                  },
                  "kind": {
                    "type": "string",
                    "description": "CONSUMER / MEMBER / CARRIER / TAX_ID / DONATE"
                  },
                  "carrierType": {
                    "type": "string",
                    "description": "CARRIER 时"
                  },
                  "carrierId": {
                    "type": "string",
                    "description": "CARRIER 时"
                  },
                  "taxId": {
                    "type": "string",
                    "description": "TAX_ID 时"
                  },
                  "name": {
                    "type": "string",
                    "description": "TAX_ID 时可填"
                  },
                  "donateCode": {
                    "type": "string",
                    "description": "DONATE 时"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mp/sales-invoice": {
      "get": {
        "summary": "我的发票（跨商家）",
        "description": "要登录；买家身份只取登录态，入参不收用户号。",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
