{
  "openapi": "3.0.3",
  "info": {
    "title": "打印运营诊断接口",
    "version": "1.0.0",
    "description": "后端接口已交付，运营页面待接入；仅 shop.print.enabled=true 且 ops profile 启用。UNKNOWN 不代表完成，不自动补打；操作结果通过原 operationNo 查询。"
  },
  "paths": {
    "/ops/print/health": {
      "get": {
        "summary": "指定数据域打印健康汇总",
        "x-permission": "ops:print:read",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "tenantNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "storeNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；经过统一响应封装",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/FleetHealth"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ops/print/incidents": {
      "get": {
        "summary": "指定数据域打印事件分页",
        "x-permission": "ops:print:read",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "tenantNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "storeNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；经过统一响应封装",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "records": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Incident"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "size": {
                          "type": "integer",
                          "format": "int64"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ops/print/operations/{operationNo}": {
      "get": {
        "summary": "查询原打印操作结果",
        "x-permission": "ops:print:read",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "tenantNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "storeNo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operationNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；经过统一响应封装",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Operation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ops/print/reconciliations": {
      "post": {
        "summary": "发起订单打印事实对账",
        "x-permission": "ops:print:resolve",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；经过统一响应封装",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Operation"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReconcileRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "activePrinters": {
            "type": "integer",
            "format": "int64"
          },
          "pendingJobs": {
            "type": "integer",
            "format": "int64"
          },
          "unknownJobs": {
            "type": "integer",
            "format": "int64"
          },
          "blockedRequests": {
            "type": "integer",
            "format": "int64"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Incident": {
        "type": "object",
        "properties": {
          "incidentNo": {
            "type": "string"
          },
          "storeNo": {
            "type": "string"
          },
          "incidentType": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "targetNo": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "occurrenceCount": {
            "type": "integer",
            "format": "int64"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FleetHealth": {
        "type": "object",
        "properties": {
          "stores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Health"
            }
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Operation": {
        "type": "object",
        "properties": {
          "operationNo": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "UNKNOWN",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "targetType": {
            "type": "string"
          },
          "targetNo": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "traceNo": {
                "type": "string"
              },
              "conflicts": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReconcileRequest": {
        "type": "object",
        "properties": {
          "tenantNo": {
            "type": "string"
          },
          "entityNo": {
            "type": "string"
          },
          "storeNo": {
            "type": "string"
          },
          "sourceKind": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "dryRun": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "tenantNo",
          "entityNo",
          "storeNo",
          "sourceKind",
          "from",
          "to",
          "reason"
        ]
      }
    }
  }
}
