  "components": {
    "securitySchemes": {
      "merchantBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "TWD",
              "CNY"
            ]
          },
          "minor": {
            "type": "integer",
            "format": "int64",
            "description": "Scale-2 minor units; TWD whole-unit cash quantum is100"
          }
        },
        "required": [
          "currency",
          "minor"
        ]
      },
      "Buy": {
        "type": "object",
        "properties": {
          "requestNo": {
            "type": "string"
          },
          "offerNo": {
            "type": "string"
          },
          "offerVersion": {
            "type": "integer"
          }
        },
        "required": [
          "requestNo",
          "offerNo",
          "offerVersion"
        ]
      },
      "Offer": {
        "type": "object",
        "properties": {
          "offerNo": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "planCode": {
            "enum": [
              "PRO",
              "CHAIN"
            ]
          },
          "name": {
            "type": "string"
          },
          "days": {
            "type": "integer"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "storeQuota": {
            "type": "integer"
          },
          "staffQuota": {
            "type": "integer"
          },
          "crossStoreStats": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "offerNo",
          "version",
          "planCode",
          "name",
          "days",
          "price",
          "storeQuota",
          "staffQuota",
          "crossStoreStats",
          "enabled"
        ]
      },
      "Claim": {
        "type": "object",
        "properties": {
          "claimNo": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          },
          "bankReference": {
            "type": "string"
          },
          "evidenceKey": {
            "type": "string"
          }
        },
        "required": [
          "claimNo",
          "amount",
          "paidAt",
          "bankReference",
          "evidenceKey"
        ]
      },
      "ClaimView": {
        "type": "object",
        "properties": {
          "claimNo": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "declaration": {
            "$ref": "#/components/schemas/Claim"
          },
          "reviewNote": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "claimNo",
          "status",
          "declaration",
          "reviewNote"
        ]
      },
      "ActionView": {
        "type": "object",
        "properties": {
          "actionNo": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "paymentNo": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "actionNo",
          "status",
          "paymentNo",
          "reason"
        ]
      },
      "Instructions": {
        "type": "object",
        "properties": {
          "profileNo": {
            "type": "string"
          },
          "profileVersion": {
            "type": "integer"
          },
          "platformMerchantNo": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "receivingAccountKey": {
            "type": "string"
          },
          "paymentWindowVersion": {
            "type": "string"
          },
          "paymentWindowMs": {
            "type": "integer"
          },
          "instructions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "profileNo",
          "profileVersion",
          "platformMerchantNo",
          "currency",
          "receivingAccountKey",
          "paymentWindowVersion",
          "paymentWindowMs",
          "instructions"
        ]
      },
      "OrderView": {
        "type": "object",
        "properties": {
          "orderNo": {
            "type": "string"
          },
          "requestNo": {
            "type": "string"
          },
          "entityNo": {
            "type": "string"
          },
          "storeNo": {
            "type": "string"
          },
          "offer": {
            "$ref": "#/components/schemas/Offer"
          },
          "status": {
            "type": "string",
            "enum": [
              "PREPARED",
              "AWAITING_PAYMENT",
              "SUBMITTED",
              "CONFIRMING",
              "APPLIED",
              "UNMATCHED",
              "REVIEW_REQUIRED",
              "CANCELLATION_REQUESTED",
              "CLOSING",
              "CANCELLED"
            ]
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "instructions": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Instructions"
              },
              {
                "type": "null"
              }
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimView"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionView"
            }
          }
        },
        "required": [
          "orderNo",
          "requestNo",
          "entityNo",
          "storeNo",
          "offer",
          "status",
          "dueAt",
          "instructions",
          "claims",
          "actions"
        ]
      }
    }
  }
}
