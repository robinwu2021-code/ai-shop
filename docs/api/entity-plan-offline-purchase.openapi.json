{
  "openapi": "3.1.0",
  "info": {
    "title": "Entity quota offline purchase for separate Flutter App",
    "version": "2026-11-11",
    "description": "Implemented and locally verified, not deployed; not a store mall plan."
  },
  "paths": {
    "/biz/plan/purchases/offers": {
      "get": {
        "operationId": "get_biz_plan_purchases_offers",
        "security": [
          {
            "merchantBearer": []
          }
        ],
        "description": "Owner only, biz:store:admin and frozen selected store context. Check envelope.code; claim is not money.",
        "parameters": [
          {
            "name": "X-Store-No",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Business envelope; code=0 is transport business success, never infer activation except status APPLIED.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Offer"
                      }
                    }
                  },
                  "required": [
                    "code",
                    "msg",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
