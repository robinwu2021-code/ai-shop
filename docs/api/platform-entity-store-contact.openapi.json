{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform entity creation and store contacts",
    "version": "2026-11-15"
  },
  "paths": {
    "/biz/entities": {
      "get": {
        "operationId": "listOwnedPlatformEntities",
        "description": "Personal MERCHANT/USR account only; no selected-store/entity headers required. Lists current active owner memberships, including entities with zero stores. MCH credentials are forbidden. Each result is enriched with current review state. POST /biz/entities and GET /biz/entities/create-results/{requestNo} are documented in entity-profile-workspace.openapi.json.",
        "security": [
          {
            "merchantBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Existing envelope; code=0 success; MCH identity returns FORBIDDEN.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EntityVO"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/biz/store/settings": {
      "get": {
        "operationId": "storeSettingsWithContact",
        "security": [
          {
            "merchantBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Existing envelope: code=0 success; business codes 10400/10403/10404/10409 reject invalid input/ownership/unknown request/changed intent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "profile",
                        "sectionVersions",
                        "allowedActions"
                      ],
                      "properties": {
                        "profile": {
                          "type": "object",
                          "properties": {
                            "contactName": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "contactPhone": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "additionalProperties": true
                        },
                        "sectionVersions": {
                          "type": "object",
                          "required": [
                            "BASIC",
                            "HOURS",
                            "CONTACT"
                          ],
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "allowedActions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/biz/store/settings/contact": {
      "post": {
        "operationId": "saveStoreContact",
        "security": [
          {
            "merchantBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Existing envelope: code=0 success; business codes 10400/10403/10404/10409 reject invalid input/ownership/unknown request/changed intent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "profile",
                        "sectionVersions",
                        "allowedActions"
                      ],
                      "properties": {
                        "profile": {
                          "type": "object",
                          "properties": {
                            "contactName": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "contactPhone": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "additionalProperties": true
                        },
                        "sectionVersions": {
                          "type": "object",
                          "required": [
                            "BASIC",
                            "HOURS",
                            "CONTACT"
                          ],
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "allowedActions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "code",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expectedVersion",
                  "contactName",
                  "contactPhone"
                ],
                "properties": {
                  "expectedVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "contactName": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "contactPhone": {
                    "type": "string",
                    "maxLength": 32,
                    "pattern": "^[0-9+().\\s-]*$"
                  }
                }
              }
            }
          }
        },
        "description": "Selected-store STORE_ADMIN, identical permission to BASIC. Non-null contact fields allow clearing to empty and are trimmed. CONTACT content version checked atomically under ownership lock; BASIC/HOURS versions do not cover contacts. EDIT_CONTACT is advertised only to STORE_ADMIN."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "merchantBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "EntityVO": {
        "type": "object",
        "required": [
          "entityNo",
          "name",
          "status",
          "verified",
          "legalForm",
          "storeCount",
          "isPrimary",
          "canManage",
          "review",
          "applyNo",
          "rejectReason",
          "taxNo",
          "owner",
          "platformReview",
          "draftVersion",
          "approvedProfileVersion",
          "payMerchantNo"
        ],
        "properties": {
          "entityNo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "ACTIVE / PENDING_LICENSE / SUSPENDED / BANNED."
          },
          "verified": {
            "type": "boolean"
          },
          "legalForm": {
            "type": [
              "string",
              "null"
            ]
          },
          "storeCount": {
            "type": "integer"
          },
          "isPrimary": {
            "type": "boolean"
          },
          "canManage": {
            "type": "boolean"
          },
          "review": {
            "type": [
              "string",
              "null"
            ],
            "description": "Without a pay profile summary: APPROVED (not PENDING_LICENSE) or NONE / REVIEWING / REJECTED from the latest apply; replaced by platformReview when a pay profile summary exists."
          },
          "applyNo": {
            "type": [
              "string",
              "null"
            ]
          },
          "rejectReason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reject reason when review=REJECTED, else \"\"."
          },
          "taxNo": {
            "type": [
              "string",
              "null"
            ],
            "description": "Business licence number; \"\" when unknown."
          },
          "owner": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest apply contactName; \"\" when no apply."
          },
          "platformReview": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pay entity-profile summary platformReview; null when no summary."
          },
          "draftVersion": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "approvedProfileVersion": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "payMerchantNo": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "merchant.dto.EntityVO after EntityReviewAssembler.enrich."
      }
    }
  }
}
