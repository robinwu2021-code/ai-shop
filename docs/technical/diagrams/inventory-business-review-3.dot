digraph G {
graph [bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.7", fontname="Arial", label="库存预留状态建议", labelloc=t, fontsize=20];
node [shape=box, style="rounded,filled", fillcolor="#f3f7fc", color="#516781", fontname="Arial", fontsize=13, margin="0.18,0.12"];
edge [fontname="Arial", fontsize=11, color="#516781", arrowsize=0.8];
"START" [label="START",shape=circle];
"HELD" [label="HELD",shape=box];
"ALLOCATED" [label="ALLOCATED",shape=box];
"RELEASED" [label="RELEASED",shape=box];
"EXPIRED" [label="EXPIRED",shape=box];
"FULFILLED" [label="FULFILLED",shape=box];
"END" [label="END",shape=doublecircle];
"START" -> "HELD" [label="下单预留"];
"HELD" -> "ALLOCATED" [label="支付确认（建议新增）"];
"HELD" -> "RELEASED" [label="取消"];
"HELD" -> "EXPIRED" [label="订单关单确认"];
"ALLOCATED" -> "FULFILLED" [label="实际出库（建议替代支付即COMMITTED）"];
"ALLOCATED" -> "RELEASED" [label="未出库退款成功"];
"FULFILLED" -> "END" [label=""];
}
// Original diagram source, retained for provenance:
// stateDiagram-v2
//   [*] --> HELD: 下单预留
//   HELD --> ALLOCATED: 支付确认（建议新增）
//   HELD --> RELEASED: 取消
//   HELD --> EXPIRED: 订单关单确认
//   ALLOCATED --> FULFILLED: 实际出库（建议替代支付即COMMITTED）
//   ALLOCATED --> RELEASED: 未出库退款成功
//   FULFILLED --> [*]
