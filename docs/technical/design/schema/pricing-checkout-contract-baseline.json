        "gap": [
          "Unique settlement_no+scope_key does not serialize same source scope across two settlements",
          "Core must own payable scope reservation and paid/UNKNOWN overlap detection",
          "Preserve original core scope version and quantity/tax allocation identity"
        ],
        "decision": "CORE_SCOPE_LOCK_REQUIRED"
      },
      {
        "table": "fnb_charge_intent",
        "keep": [
          "intent_no",
          "settlement_no",
          "request_key",
          "request_hash",
          "request_snapshot",
          "core_reference",
          "status",
          "cash_shift_no"
        ],
        "gap": [
          "Original schema lacks an explicit unique shared consumer key for the same core payable scope across different settlements",
          "Core must enforce stable source/operation key; request key per settlement alone is insufficient",
          "No general external transaction success proof can be inferred from CONFIRMED string"
        ],
        "decision": "REUSE_INTENT_CORE_OWNS_FINANCIAL_IDEMPOTENCY"
      }
