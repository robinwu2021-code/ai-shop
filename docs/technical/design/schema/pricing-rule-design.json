  "ruleTypes": [
    {
      "kind": "PRICE_REPLACE",
      "category": "PRICE",
      "stage": "PRICE_CORRECTION",
      "basis": "NAMED_COMPONENT",
      "note": "One approved correction per component; benefits must permit manually priced goods"
    },
    {
      "kind": "MANUAL_PERCENT",
      "category": "DISCOUNT",
      "stage": "MANUAL_PROMOTION",
      "basis": "ELIGIBLE_GOODS_CURRENT",
      "parameter": "payableRateBp",
      "exclusiveGroup": "MANUAL_PROMOTION"
    },
    {
      "kind": "MANUAL_AMOUNT",
      "category": "DISCOUNT",
      "stage": "MANUAL_PROMOTION",
      "basis": "ELIGIBLE_GOODS_CURRENT",
      "parameter": "amountMinor",
      "exclusiveGroup": "MANUAL_PROMOTION"
    },
    {
      "kind": "ACTIVITY",
      "category": "DISCOUNT",
      "stage": "ACTIVITY",
      "basis": "OWNER_DEFINED",
      "note": "Apply existing owner decisions, never broaden retail/offline rules"
    },
    {
      "kind": "PERCENT_COUPON",
      "category": "DISCOUNT",
      "stage": "COUPON",
      "basis": "POST_ACTIVITY_ELIGIBLE_GOODS",
      "parameter": "payableRateBp",
      "exclusiveGroup": "ORDER_COUPON"
    },
    {
      "kind": "CASH_COUPON",
      "category": "DISCOUNT",
      "stage": "COUPON",
      "basis": "POST_ACTIVITY_ELIGIBLE_GOODS",
      "parameter": "amountMinor",
      "exclusiveGroup": "ORDER_COUPON"
    },
    {
      "kind": "MANUAL_WAIVER",
      "category": "RECEIVABLE_ADJUSTMENT",
      "stage": "MANUAL_WAIVER",
      "basis": "AUTHORIZED_UNPAID_SCOPE",
      "note": "Approved cap, no negative due; tax/accounting adaptation required"
    },
    {
      "kind": "STORED_VALUE",
      "category": "FUNDING",
      "stage": "FUNDING",
      "basis": "PAY_VERIFIED_APPLICABLE_SCOPE",
      "note": "Principal and bonus remain PAY facts; no discount or cash change"
    },
    {
      "kind": "CASH_ROUNDING",
      "category": "RECEIVABLE_ADJUSTMENT",
      "stage": "CASH_ROUNDING",
      "basis": "FINAL_CASH_REMAINDER",
      "note": "Off until verified policy; once on final scope, avoid repeated waiver"
    },
    {
      "kind": "CASH_TENDER",
      "category": "TENDER",
      "stage": "CASH_TENDER",
      "basis": "CASH_DUE",
      "note": "Only cash tender yields change"
    },
    {
      "kind": "POINTS",
      "category": "SETTLEMENT_DEDUCTION",
      "stage": "POINTS",
      "basis": "OWNER_VERIFIED_REMAINDER_AFTER_STORED_VALUE",
      "note": "No automatic use; source and actual points owner must support the sequence"
    }
  ],
