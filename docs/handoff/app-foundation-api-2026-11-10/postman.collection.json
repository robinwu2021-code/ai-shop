            {
              "key": "expectedVersion",
              "value": "{{expectedVersion}}",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "选择<=5MiB的允许证明文件；让Postman生成multipart boundary，勿手填Content-Type。上传回执的version要用于下一步。"
      },
