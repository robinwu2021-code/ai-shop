# 元器件小程序。只接真后端，**没有 mock** —— mock 会盖住「接口不存在」（运营端吃过这个亏）。
# 本地：elec-svc 起在 8085、主系统起在 8081，由 vite.config.mts 的 proxy 分流。
VITE_USE_MOCK=0

# 本地存储命名空间：与 c-app（shc）/ b-app（shb）各归各
VITE_APP_NS=she

# 订阅消息模板号：「询价有报价了」「有新求购」「报价被选中」。
# **还没选**（TDD-元器件-前端独立与通知矩阵 §L4 待拍板 2）—— 留空时 requestSubscribe 整批剔掉、不弹窗
VITE_WX_TPL_ELEC_QUOTED=
VITE_WX_TPL_ELEC_DISPATCH=
VITE_WX_TPL_ELEC_PICKED=
