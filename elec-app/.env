# 元器件小程序。只接真后端，**没有 mock** —— mock 会盖住「接口不存在」（运营端吃过这个亏）。
# 本地：elec-svc 起在 8085、主系统起在 8081，由 vite.config.mts 的 proxy 分流。
VITE_USE_MOCK=0

# 本地存储命名空间：与 c-app（shc）/ b-app（shb）各归各
VITE_APP_NS=she

# 订阅消息模板号：询价有报价了 / 有新求购 / 报价被选中 —— **同一个模板**（公共模板 2319「报价更新通知」）。
# 模板号属于小程序号：这一个是在虹选好店（wx3201250c28393850）的「我的模板」里加的；
# 元器件独立发布到自己的小程序号时要在那个号上重新加一次、换掉这里与主系统的 WX_TPL_ELEC_QUOTED。
# **必须与主系统 WX_TPL_ELEC_QUOTED 同值**。模板号不是密钥
VITE_WX_TPL_ELEC_QUOTED=MrMSM7UmyOk8Psdy3u1LmIEcr2y66FTZRLyLDsjsR5k
