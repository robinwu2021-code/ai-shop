{
  "name": "元器件",
  "appid": "",
  "description": "电子元器件：查料号、询价、供应商传库存",
  "versionName": "0.1.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
    /* 独立小程序的 appid **还没申请**（TDD-元器件-前端独立与通知矩阵 §L4）。
       空着时开发者工具按测试号打开；上传前必须填上，且主系统要认这个 appid 的 wx.login code
       （静默登录换 openid 用的是 appid + secret，另一个小程序的 code 换不出来）。 */
    "appid": "",
    "setting": { "urlCheck": false, "minified": true },
    "usingComponents": true,
    /* 与 c-app 同一个原因（见那边的长注释）：组件根要吃到调用点的 class */
    "mergeVirtualHostAttributes": true,
    "lazyCodeLoading": "requiredComponents"
  },
  "h5": {
    "title": "元器件",
    "router": { "mode": "hash" }
  },
  "vueVersion": "3"
}
