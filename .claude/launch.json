{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "c-app-h5",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:h5"
      ],
      "cwd": "c-app",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "b-app-h5",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "PORT=5174 npm run dev:h5"
      ],
      "cwd": "b-app",
      "port": 5174,
      "autoPort": false
    },
    {
      "_comment": "端口必须是 3100 —— 后端 SecurityConfig 的 CORS 白名单只认它。照默认的 3000 起，页面上每个列表都是「网络异常」，而控制台里只有一条被浏览器拦掉的预检。autoPort 同理要关：换了端口就跨不过去。",
      "name": "ops-web",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "PORT=3100 npm run dev"
      ],
      "cwd": "ops-web",
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "JAVA_HOME=/opt/homebrew/Cellar/openjdk@21/21.0.11/libexec/openjdk.jdk/Contents/Home mvn -o -f shop-app/pom.xml spring-boot:run -Dspring-boot.run.arguments=--shop.seed.enabled=true"
      ],
      "cwd": "backend",
      "port": 8080
    },
    {
      "_comment": "mock 数据跑 B 端 —— 验证页面行为用，不依赖后端起没起。真机联调用 b-app-h5（连 8081）",
      "name": "b-app-mock",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "PORT=5175 VITE_USE_MOCK=1 VITE_API_BASE= npm run dev:h5"
      ],
      "cwd": "b-app",
      "port": 5175,
      "autoPort": false
    }
  ]
}
