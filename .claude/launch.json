{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "c-app-h5",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:h5"
      ],
      "cwd": "c-app",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "b-app-h5",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "PORT=5174 npm run dev:h5"
      ],
      "cwd": "b-app",
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "ops-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "ops-web",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "JAVA_HOME=/opt/homebrew/Cellar/openjdk@21/21.0.11/libexec/openjdk.jdk/Contents/Home mvn -o -f shop-app/pom.xml spring-boot:run -Dspring-boot.run.arguments=--shop.seed.enabled=true"
      ],
      "cwd": "backend",
      "port": 8080
    }
  ]
}
