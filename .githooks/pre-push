#!/usr/bin/env bash
#
# 推之前从 HEAD 拉一份干净副本编一遍。
#
# 为什么是 pre-push 而不是 CI：后端的父 POM（ai.neargo:neargo-parent）和整套
# neargo-common-* 只存在于开发机的 ~/.m2，公网仓库里没有 —— GitHub 托管的 runner
# 拿不到，所以云端 CI 目前编不了后端（见 .github/workflows/backend.yml 顶部）。
# 而这台机器上有 .m2，闸门就该立在这里。
#
# 跳过（仅限确知不涉及后端的推送）：SKIP_COMPILE_GATE=1 git push
set -euo pipefail

if [ "${SKIP_COMPILE_GATE:-}" = "1" ]; then
  echo "⚠ 已跳过编译闸门（SKIP_COMPILE_GATE=1）"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

# ── 下面两道闸都在 HEAD 的干净副本里跑 ──────────────────────────────────────
#
# ⚠️ **它们此前读的是工作区**，而这个目录常有多个会话同时在改。后果是：
# 任何人手上有一个**未提交**的新页面，全员都推不动 —— 而被挡住的人看到的是
# 「+ 新增 b-app/pages/schedule/index」，一个跟他毫不相干的页面名。
# 他既不知道是谁的，也不该替对方跑生成器（跑了就等于把别人的半成品
# 烘进一个已提交的产物）。2026-08-25 真的挡住了一个只改前端文案的会话。
#
# 与编译闸门是同一条教训：**闸门要判的是「推出去的那份对不对」，
# 判据必须取自 HEAD，不是谁的工作区。** check-head-compiles.sh 一直是这么做的，
# 这两道快闸漏了。
#
# 代价是一次 worktree（几百毫秒）。两道闸本身仍是纯读文件、几十毫秒，
# 所以仍不做「没动过就跳过」的判断 —— 那种判断会漏掉「改了生成器本身」这一类。
GATE_WT="$(mktemp -d)/head-gates"
cleanup() { git worktree remove --force "$GATE_WT" >/dev/null 2>&1 || true; }
trap cleanup EXIT
git worktree add -q --detach "$GATE_WT" HEAD

# 界面清单闸门：清单是三端 UI 的唯一索引（docs/technical/design/ui-catalog.json），
# 由 pages.json 与 nav.ts 生成。改了路由/标题/导航而没重跑生成器，这一条就红。
# 纯 python、不需要依赖，所以在 worktree 里能直接跑（那里没有 node_modules）。
if ! python3 "$GATE_WT/scripts/gen-ui-catalog.py" --check; then
  echo "  ↑ 判据取自 HEAD。工作区里未提交的页面不会让你被挡住，也不会替别人放行。"
  exit 1
fi

# V2 文档守卫：那套文档里同一事实被写了两遍的地方不少（术语层、能力码、状态、
# 表名、自称数字）。一次人工 review 抓到过一处实质漂移 —— 可售时段的关系表
# 在对齐清单里挂 goods、在规格书里挂 listing，**表名不同只是表面，粒度错了才是缺陷**。
# 靠人比对四十份文档不可持续，所以查四类机器查得动的：断链 / 表名集合 /
# 自称数字 / 能力码取值域。纯 node 内置模块，几十毫秒。
# 查不动的（叙述矛盾、语义粒度）仍靠 review —— 它不假装能替代。
if ! node "$GATE_WT/scripts/check-v2-docs.mjs"; then
  echo "  ↑ 判据取自 HEAD。本机重现：node scripts/check-v2-docs.mjs"
  exit 1
fi

# ops-web 契约闸门：运营端默认走 mock，所以「前端调了一个后端根本没有的接口」
# 在界面上看不出来 —— 页面有数据、点得动、不报错，一直到真连后端那天才集体爆出来。
# 锁的是差集：已知欠账放行（ops-web/known-mock-endpoints.txt），新写的空接口拦下。
# 只用 node 内置模块，同样不需要 node_modules。
if ! node "$GATE_WT/scripts/check-ops-contract.mjs" --check; then
  exit 1
fi

# 反向那一侧：**后端做了、运营端没有入口**。两个方向都要盯 ——
# 「画了没后端」在切真后端时会 404，看得见；「做了没入口」不报任何错，
# 它表现为「这个功能我们做过啊」，而运营点不到。
# 2026-08-26 首扫 18 条，其中 13 条是整条自营应付+发票链路，
# 而那是当时唯一真能把钱付出去的路。
# 同一条判据的 App 端：**页面注册了、app 里没有一处跳得过去**。
# 2026-08-26 一天撞三次（my-specs 更早那次、income 已随包上了线、
# sku-identity 装到真机才发现）。三次都不报错 —— 页面是好的、路由是对的、
# 包也打进去了，只是点不到；而在 H5 上验页面时直接改 hash 进去，
# 「有没有门」这件事从来不在验证路径上。
if ! node "$GATE_WT/scripts/check-app-orphan.mjs" --check; then
  exit 1
fi

if ! node "$GATE_WT/scripts/check-ops-orphan.mjs" --check; then
  exit 1
fi

# Controller 粒度：一个类只装一个资源（阈值 3）。判据是**路径第一段的种数**，
# 不是端点数 —— 按端点数定阈值会逼人把一个资源硬拆成两半来达标。
# 由来：BizMerchantController 一个类 40 端点 / 1022 行 / 九个不相干的节，
# 而每个往里加的人都有一个局部合理的理由。这道闸就是补那一眼。
if ! node "$GATE_WT/scripts/check-controller-cohesion.mjs" --check; then
  exit 1
fi

# 生成物有没有跟着源码走。**在本条之前只有界面清单有闸门**，
# 其余五个生成器谁都不盯，于是一直在漂：2026-08-26 重跑一次，
# API 清单 +51/−16、B 端功能点矩阵 +192/−69。
# 清单的价值全在「说的是真话」—— 漏了十几个接口的清单比没有清单更糟。
#
# ⚠️ 它会**真的写文件**，所以必须跑在 $GATE_WT（HEAD 干净副本）上，
# 不碰任何人的工作区。与编译闸门同一条规矩：判的是「推出去的那份对不对」。
#
# ⚠️ 这一条与上面两道不同：**它需要 node_modules**（gen-api-detail 用了 yaml 包）。
# worktree 里没有，所以软链主仓的过去。链而不是装：npm i 要几十秒，
# 而这道闸本身只有几百毫秒 —— 为一道闸让每次推送多等半分钟不划算。
# 主仓没装依赖时跳过并说明，**不静默放行**：说不清自己有没有跑，比没跑更糟。
if [ -d "$ROOT/node_modules" ]; then
  ln -sfn "$ROOT/node_modules" "$GATE_WT/node_modules"
  if ! node "$GATE_WT/scripts/check-generated-docs.mjs" --check; then
    exit 1
  fi
else
  echo "⚠ 跳过生成物闸门：本机没有 node_modules（跑一次 npm i 就会启用）"
fi

# 设计守卫：字阶 / 圆角 / 皮肤变量 / 令牌对比度 / 字符当图标 / 三语词条一致 / 词条引用存在。
#
# **最后一条 2026-08-27 加**：`i18n-parity` 比的是「三种语言的 key 集合一致」，
# 而 C 端社区页那十个 key **在三种语言里都缺**，缺得整整齐齐 —— 它一致、它绿，
# 而用户那一屏直接显示 `community.noLocation` 这串字符。
# 一致 ≠ 存在，这是两条不同的断言。
#
# **最后一条 2026-08-27 才挂上，而守卫本身早就写好了。** 它拦的是「中文加了词条、
# 英/阿没跟上」—— 后果是那两种语言的用户直接看到裸 key（`picking.qtyTitle` 这种）。
# 挂上去当天就发现 HEAD 上已经缺了 6 条。**工具是有的，只是没有人被它挡住过** ——
# 与「仓库里一直有 type-check 脚本却没挂闸」是同一个形状。
#
# **为什么到现在才挂**：这三道 2026-08-26 之前一直是红的（7 条断言），
# 而**恒红的闸门挂上去等于全员推不动** —— 结果只会是加一个 SKIP 开关，
# 那就等于没有闸门。先修绿、再挂闸，顺序反了做不成。
#
# 它们拦的是「代码违不违反规范」，与上面那道生成物闸门（拦「清单说没说真话」）
# 是两件事，别混。
#
# 判据取自 $GATE_WT（HEAD 干净副本），与其它几道一致：**闸门要判的是
# 「推出去的那份对不对」，不是谁的工作区**。跑 vitest 需要 node_modules，
# 上面那段已经把主仓的软链过去了；没有就跳过并说明，不静默放行。
if [ -d "$ROOT/node_modules" ]; then
  if ! (cd "$GATE_WT/packages/shared" && npx vitest run \
        tests/typography.test.ts tests/design-tokens.test.ts \
        tests/skin-vars.test.ts tests/ui-package.test.ts \
        tests/icon-chars.test.ts tests/i18n-parity.test.ts \
        tests/i18n-keys-exist.test.ts tests/validate.test.ts tests/region.test.ts tests/input-bounds.test.ts tests/ops-ui-discipline.test.ts tests/env-consumed.test.ts tests/bean-validation-wired.test.ts tests/api-path-naming.test.ts >/dev/null 2>&1); then
    echo "✗ 设计守卫红了（字阶 / 圆角 / 皮肤变量 / 令牌 / 字符当图标 / 三语词条 / 词条引用 / 输入校验 / 省市区拆分 / 输入上限 / 运营端纪律 / 环境变量接线 / 校验注解接线 / 端点命名）。看是哪一条："
    echo "    cd packages/shared && npx vitest run tests/typography.test.ts tests/design-tokens.test.ts tests/skin-vars.test.ts tests/ui-package.test.ts tests/icon-chars.test.ts tests/i18n-parity.test.ts tests/i18n-keys-exist.test.ts tests/validate.test.ts tests/region.test.ts tests/input-bounds.test.ts tests/ops-ui-discipline.test.ts tests/env-consumed.test.ts tests/bean-validation-wired.test.ts tests/api-path-naming.test.ts"
    echo "  判据取自 HEAD —— 工作区里没提交的改动不会让你被挡住。"
    exit 1
  fi
else
  echo "⚠ 跳过设计守卫：本机没有 node_modules（跑一次 npm i 就会启用）"
fi

# 自造件棘轮：**新页面不许自造库里已经有的件**。
#
# 为什么这一刻才立：2026-08-26 这一轮把缺件补齐（库 14 → 27 个组件，
# 缺口 16 类 → 1 类）。闸门要立在刚清完的时候 —— 早了是恒红，晚了就又长回来。
# `sh-tabs` 的方块 tab 收编过一次，没有闸门，后来新页面又各画各的。
#
# 判据不在这里，在 gen-ui-lib.py 的 ROLLED 表 —— 所以这里先重跑生成器再判，
# 免得清单本身是陈的。纯 python，worktree 里不需要依赖。
# 已知的 33 处欠账记在 known-handrolled-ui.txt，**只准变短**：
# 修好了不删那一行，那个页面将来又自造起来也不会有人发现。
if python3 "$GATE_WT/scripts/gen-ui-lib.py" >/dev/null 2>&1; then
  # 逐页体检：页面有没有照三份规范写（字阶 / 圆角与间距 / 颜色）。
  # 与上面那道「有件不用」是两件事：这道管的是「自己写了一行 font-size」。
  if ! python3 "$GATE_WT/scripts/check-page-spec.py" --check >/dev/null 2>&1; then
    echo "✗ 有页面没照规范写（字阶 / 圆角与间距 / 颜色）。看是哪一页："
    echo "    python3 scripts/check-page-spec.py --check"
    echo "  清单：known-page-spec-debt.txt（只准变短）"
    exit 1
  fi

  if ! node "$GATE_WT/scripts/check-handrolled-ui.mjs" --check --root="$GATE_WT"; then
    exit 1
  fi
else
  echo "⚠ 跳过自造件棘轮：ui-lib 生成器在 HEAD 副本里跑不起来"
fi

# 类型检查（两端 uni-app）。**这一条是被一个真缺陷催出来的**：
# 仓库里一直有 `npm run type-check` 脚本，却没挂在任何闸门上，于是
# `stock-check` 与 `transfer` 把 showModal 换成 confirm() 时留下了 `content:` ——
# ConfirmOptions 没这个字段，**说明文字被静默丢掉**：盘点看不到差异件数、
# 收货看不到数量和去向。页面照样跑、H5 照样构建、没有任何报错。
#
# 两端加起来不到 5 秒，比下面的后端编译便宜得多，所以不做「没动过就跳过」。
# worktree 里要把两端各自的 node_modules 也软链过去（npm workspaces 没把
# uni-app 那套类型全提到根上）。
if [ -d "$ROOT/node_modules" ]; then
  ln -sfn "$ROOT/b-app/node_modules" "$GATE_WT/b-app/node_modules" 2>/dev/null
  ln -sfn "$ROOT/c-app/node_modules" "$GATE_WT/c-app/node_modules" 2>/dev/null
  for app in b-app c-app; do
    if ! (cd "$GATE_WT/$app" && npx vue-tsc --noEmit 2>&1); then
      echo "✗ $app 类型检查没过（上面是原始输出）。本机重现："
      echo "    cd $app && npx vue-tsc --noEmit"
      echo "  判据取自 HEAD —— 工作区里没提交的改动不会让你被挡住。"
      exit 1
    fi
  done
else
  echo "⚠ 跳过类型检查：本机没有 node_modules（跑一次 npm i 就会启用）"
fi

# 后端没动过就不必编 —— 别为改一行文案等两分钟
if git diff --quiet "@{u}" HEAD -- backend 2>/dev/null; then
  echo "→ 本次推送未触及 backend/，跳过编译闸门"
  exit 0
fi

exec "$ROOT/scripts/check-head-compiles.sh"
