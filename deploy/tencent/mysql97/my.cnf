# MySQL 9.7 LTS · 待机实例（将来替代 MariaDB）
#
# ⚠️ 这个文件只能经 --defaults-file 读取（见 mysql97.service）。
# 不带它的话 mysqld 会按默认顺序读 /etc/my.cnf、/etc/mysql/my.cnf ——
# 后者是 **MariaDB 的**配置，里面有 MariaDB 专有选项，还有它的 datadir / socket / port。
# 读错了轻则起不来，重则两个实例抢同一个数据目录。
#
# 取向是「尽量小的资源」：它现在是待机实例，没有业务流量。
# 真要切成主库时，下面标了【切主前调】的几项必须重新定。

[mysqld]
user                    = mysql
basedir                 = /opt/mysql/current
datadir                 = /var/lib/mysql97
socket                  = /run/mysqld97/mysqld.sock
pid-file                = /run/mysqld97/mysqld.pid
log_error               = /var/log/mysql97/error.log
tmpdir                  = /tmp

# ── 网络：只监听本机，端口让开 MariaDB 的 3306 ───────────────────────────
port                    = 3307
bind-address            = 127.0.0.1
skip-name-resolve
# X 协议（33060）用不到：关掉省一个监听端口和一组线程
mysqlx                  = OFF

# ── 认证：root 只认操作系统身份（本机 root 经 socket 登录），不设任何密码 ──
plugin-load-add         = auth_socket.so

# ── 内存：这几项是「尽量小」的主要来源 ───────────────────────────────────────
# performance_schema 默认开着时常驻 200~400MB，是待机实例里最大的一块 【切主前调：生产建议开】
performance_schema      = OFF
# 缓冲池：默认 128M，这里维持最小的一个 chunk 【切主前调：按数据量，通常给到可用内存一半】
innodb_buffer_pool_size = 128M
# 内部临时表的内存上限：9.x 默认按总内存的 3% 取、且不低于 1G —— 待机实例用不着
temptable_max_ram       = 64M
tmp_table_size          = 16M
max_heap_table_size     = 16M
innodb_log_buffer_size  = 8M
key_buffer_size         = 8M
# 连接：待机实例几条就够 【切主前调：≥ 应用连接池上限 × 实例数 + 运维余量】
max_connections         = 40
thread_cache_size       = 4
table_open_cache        = 256
table_definition_cache  = 400

# ── 磁盘 ──────────────────────────────────────────────────────────────────────
# redo 容量：默认 100M，待机实例写得很少
innodb_redo_log_capacity = 64M
innodb_flush_method     = O_DIRECT
# binlog 先关：还不是主库，省盘 【切主前调：必须打开 —— 按时间点恢复靠它】
disable_log_bin

# ── 字符集 ────────────────────────────────────────────────────────────────────
# ⚠️ **与现网不完全一致，而且没法一致。** 现网 MariaDB 用的是 utf8mb4_uca1400_ai_ci
#    （175 张表；另有 1 张 utf8mb4_unicode_520_ci）—— uca1400 是 MariaDB 专有的
#    UCA 14.0 排序规则，MySQL 里没有。最接近的是下面这个（UCA 9.0）。
#    迁移时要显式映射；边缘字符（新增 emoji、部分 CJK 扩展区）的比较与排序会有差异，
#    唯一索引上尤其要先比对一遍。见 README「迁移前要解决的事」。
character-set-server    = utf8mb4
collation-server        = utf8mb4_0900_ai_ci

[client]
socket                  = /run/mysqld97/mysqld.sock
port                    = 3307
