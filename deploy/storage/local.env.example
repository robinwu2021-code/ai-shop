# Region-related environment configuration contains only the default market.
# Language, currency, scale, timezone and product amount precision come from system data.
SHOP_DEFAULT_MARKET=TW
# Host: /data0/app/ai-shop/storage -> container: /data/storage (persistent read/write mount).
SHOP_STORAGE_ROOT=/data/storage
SHOP_MEDIA_PROVIDER=local
# Supply via existing private env/secret management; API and OPS must share this key.
SHOP_MEDIA_SIGN_SECRET=
# Printing uses its own provider, signing key and private directory.
SHOP_PRINT_ARTIFACTS_PROVIDER=local
SHOP_PRINT_ARTIFACTS_SIGNING_KEY=
# Do not set SHOP_UPLOAD_DIR or SHOP_PRINT_ARTIFACTS_ROOT to an empty string.
# Leave them unset to inherit SHOP_STORAGE_ROOT, or keep an explicit existing directory.
# SHOP_UPLOAD_DIR=/data/uploads
# SHOP_PRINT_ARTIFACTS_ROOT=/data/print-private
