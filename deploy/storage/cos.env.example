# Region-related environment configuration contains only the default market.
# Language, currency, scale, timezone and product amount precision come from system data.
SHOP_DEFAULT_MARKET=TW
# Explicit provider; COS credentials are provided privately, never committed.
SHOP_MEDIA_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_DOMAIN=
COS_PRIVATE_BASE_URL=
# Printing is independently configurable and must use a private bucket.
SHOP_PRINT_ARTIFACTS_PROVIDER=cos
SHOP_PRINT_ARTIFACTS_COS_BUCKET=
