# ai-shop 内嵌支付域的独立进程模板；不是独立near-pay项目。
# PAY_*由本项目消费者读取，不要套用独立near-pay的NEARPAY_*重命名脚本。
# 部署位置：soukmind-tx /data/app/ai-shop/pay-svc/pay.env（应 600）；读取方：systemd ai-shop-pay.service
PAY_SVC_PORT=8083
PAY_DB_URL=jdbc:mysql://127.0.0.1:3307/ai_shop?<params>
PAY_DB_USER=<user>
# [秘密]
PAY_DB_PASSWORD=<secret>
# [秘密] 与 shop-app.env 同值
SHOP_SERVICES_INTERNAL_TOKEN=<secret>
