# ai-shop 主应用（api,ops）进程环境
# 部署位置：soukmind-tx /data/app/ai-shop/shop-app/shop-app.env   权限应为 600（属主运行用户）
# 读取方：systemd ai-shop.service EnvironmentFile=；另被 backup-to-cos.sh、logwatch-mail.py、wx-subscribe-templates.py 读取
# 工作站镜像：~/work/env/server-mirror/ai-shop/shop-app.env（应 600）
# [秘密] 标记的项规划迁入 SEC（见 docs/delivery/23-商户与渠道密钥存储/存储方案.md §10–§11）

# ---- 默认地区（仅此地区业务参数放环境变量）----
# 新实例必须明确配置；语言、币种、scale、时区由系统地区配置选择。
SHOP_DEFAULT_MARKET=<market-code>

# ---- 数据库 ----
# 主库
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/ai_shop?<params>
SHOP_DB_USER=<user>
# [秘密]
SHOP_DB_PASS=<secret>
# 迁移脚本含 ${} 文本时关闭占位替换
SPRING_FLYWAY_PLACEHOLDER_REPLACEMENT=false
# 库存模块
SHOP_INVENTORY_ENABLED=<true|false>
# 库存权威方
SHOP_INVENTORY_STOCK_AUTHORITY=<PLATFORM|DUAL|INVENTORY>
SHOP_INVENTORY_DATASOURCE_URL=<jdbc-url>
SHOP_INVENTORY_DATASOURCE_USERNAME=<user>
# [秘密]
SHOP_INVENTORY_DATASOURCE_PASSWORD=<secret>
# 任务注册
SHOP_JOB_ENABLED=<true|false>
# 任务库（shop-app 侧）
SHOP_JOB_DATASOURCE_URL=<jdbc-url>
SHOP_JOB_DATASOURCE_USERNAME=<user>
# [秘密]
SHOP_JOB_DATASOURCE_PASSWORD=<secret>
SHOP_JOB_FLYWAY_ENABLED=<true|false>
# 演示数据，正式必须 false
SHOP_SEED_ENABLED=false

# ---- 会话 / 站点 ----
# memory|ehcache|redis|db
SHOP_TOKEN_STORE=db
# ehcache 时使用
SHOP_SESSION_DIR=<dir>
# 分享链接域名
SHOP_WEB_BASE_URL=https://www.hxmall.top
SHOP_MERCHANT_APP_ANDROID=<apk-url>
SHOP_MERCHANT_APP_IOS=<url>
SHOP_MERCHANT_APP_MANIFEST=<url>

# ---- 服务间 ----
# [秘密] 与 pay.env、hxkey.env 同值
SHOP_SERVICES_INTERNAL_TOKEN=<secret>
# pay-svc 地址
SHOP_SERVICES_TARGETS_PAY=http://127.0.0.1:8083
# embedded|standalone
SHOP_PAY_DEPLOYMENT=standalone
# [秘密] 与 job.env JOB_TOKEN 同值
SHOP_JOB_INTERNAL_TOKEN=<secret>
# 自动化票据登录
SHOP_AUTOMATION_ENABLED=<true|false>
# 公钥（私钥在工作站 ~/work/env/ai-shop/）
SHOP_AUTOMATION_PUBLIC_KEY=<ed25519-public-key>
SHOP_AUTOMATION_SUBJECTS=<subject-list>

# ---- 短信（阿里云） ----
# true 只打日志
SHOP_SMS_STUB=false
ALI_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALI_SMS_SIGN=<签名名>
# [秘密]
ALI_SMS_AK=<access-key-id>
# [秘密]
ALI_SMS_SK=<access-key-secret>
# stub=false 时必填
ALI_SMS_TPL_OTP=<SMS_xxx>

# ---- 邮件（Office365 SMTP） ----
SHOP_MAIL_STUB=false
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_PROTOCOLS=TLSv1.2
MAIL_USERNAME=<platform@domain>
# [秘密] logwatch 当前复用
MAIL_PASSWORD=<secret>
# 必须等于 MAIL_USERNAME
MAIL_FROM=<platform@domain>

# ---- 推送 / 企业微信 ----
SHOP_PUSH_STUB=<true|false>
GETUI_APP_ID=<id>
# [秘密]
GETUI_APP_KEY=<secret>
# [秘密]
GETUI_MASTER_SECRET=<secret>
# [秘密] URL 即凭据
SHOP_NOTIFY_WECOM_WEBHOOK=<url>

# ---- 微信小程序 / 订阅 ----
SHOP_WX_STUB=false
SHOP_WX_LOGIN_STUB=false
SHOP_WX_SUBSCRIBE_STUB=<true|false>
SHOP_WX_SHIPPING_STUB=<true|false>
WX_APPID=<appid>
# [秘密]
WX_SECRET=<secret>
# developer|trial|formal
WX_MP_STATE=formal
# [秘密] 消息推送校验
WX_PUSH_TOKEN=<secret>
WX_TPL_ORDER_ARRIVED=<tpl-id>
WX_TPL_REFUNDED=<tpl-id>
WX_TPL_NEW_GOODS=<tpl-id>
WX_TPL_ELEC_QUOTED=<tpl-id>
WX_TPL_ELEC_QUOTED_FIELDS=<field-map>

# ---- 微信支付 ----
WX_PAY_ENABLED=<true|false>
# direct|ecommerce
WX_PAY_MODE=direct
WX_MCHID=<mchid>
WX_SERIAL_NO=<cert-serial>
# [秘密]
WX_APIV3_KEY=<secret>
WX_NOTIFY_URL=https://www.hxmall.top/pay/callback/WECHAT
# [秘密文件]
WX_PRIVATE_KEY_PATH=/data/app/ai-shop/shop-app/certs/<apiclient_key.pem>
WX_PLATFORM_PUBLIC_KEY=<pem-or-empty>
WX_PLATFORM_PUBLIC_KEY_PATH=/data/app/ai-shop/shop-app/certs/<pub_key.pem>

# ---- 媒体 / COS ----
# local|cos
SHOP_MEDIA_PROVIDER=cos
SHOP_MEDIA_DELIVERY=<server|direct>
COS_BUCKET=<bucket>
COS_REGION=<region>
COS_DOMAIN=<domain>
COS_PRIVATE_BASE_URL=<url>
# [秘密] 备份脚本当前复用
COS_SECRET_ID=<secret-id>
# [秘密]
COS_SECRET_KEY=<secret-key>

# ---- 物流 ----
SHOP_EXPRESS_KUAIDI100_STUB=<true|false>
# [秘密]
KUAIDI100_KEY=<secret>
# [秘密]
KUAIDI100_SECRET=<secret>
# [秘密] 推送回调签名
KUAIDI100_SALT=<secret>

# ---- AI / 地图 ----
SHOP_AI_VISION_ENABLED=<true|false>
SHOP_AI_VISION_BASE_URL=<openai-compatible-url>
SHOP_AI_VISION_MODEL=<model>
# 半秘密
AMAP_WEB_KEY=<key>

# ---- 个人信息加密 ----
# [秘密] 手机号加密，轮换需重加密
SHOP_PERSON_PHONE_KEY=<secret-base64>
# [秘密] 参与哈希索引，不轮换
SHOP_PERSON_PHONE_PEPPER=<secret>

# ---- 统一本地存储（新实例按实际挂载设置；COS仍使用原桶配置）----
# SHOP_STORAGE_ROOT=/data/storage
# SHOP_MEDIA_SIGN_SECRET=<secret-shared-by-api-and-ops>
# 打印可独立选择provider；本批不改变原打印缺省。
# SHOP_PRINT_ARTIFACTS_PROVIDER=local
# SHOP_PRINT_ARTIFACTS_SIGNING_KEY=<secret>
# 旧SHOP_UPLOAD_DIR/SHOP_PRINT_ARTIFACTS_ROOT保留实际目录时继续优先；不要设空串。
