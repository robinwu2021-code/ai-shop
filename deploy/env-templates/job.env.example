# ai-shop 任务执行器进程环境
# 部署位置：soukmind-tx /data/app/ai-shop/shop-job/job.env（应 600）；读取方：systemd ai-shop-job.service
JOB_DB_URL=jdbc:mysql://127.0.0.1:3307/ai_shop_job?<params>
JOB_DB_USER=<user>
# [秘密]
JOB_DB_PASSWORD=<secret>
# 实例名（多实例时唯一）
JOB_WORKER_INSTANCE=job-1
# 回调平台地址
JOB_TARGET_PLATFORM=http://127.0.0.1:8081
# [秘密] 与 shop-app.env SHOP_JOB_INTERNAL_TOKEN 同值
JOB_TOKEN=<secret>
# 启动时不领取任务
JOB_WORKER_START_DISABLED=<true|false>
