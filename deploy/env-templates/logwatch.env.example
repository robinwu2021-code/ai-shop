# 每小时巡检（logwatch.sh）参数
# 部署位置：soukmind-tx /data/app/ai-shop/ops/logwatch.env；SMTP 凭据当前读 shop-app.env（MAIL_ENV_FILE）
# 告警收件人
ALERT_MAIL_TO=<ops@domain>
# outbox 失败数基线，超出告警
OUTBOX_FAILED_BASELINE=<n>
# 可选：WEBHOOK_URL [秘密]、DISK_WARN=80、DISK_CRIT=90、LOG_TOTAL_MB=1024、RATE_MB_PER_H=50、TRAFFIC_PACKAGE_GB、TRAFFIC_WARN_PCT、HEALTH_UNITS、HEALTH_HTTP
