<?xml version="1.0" encoding="utf-8"?>
<!--
  按域名放开明文 HTTP 的白名单。

  **不用 android:usesCleartextTraffic="true"** —— 那是全局放开，
  一旦这个壳被拿去连别的地址，所有流量都可以是明文。这里按域名白名单。
  （注：manifest 上那个属性在 API 24+ 只要本文件存在就被忽略，留着只会误导，已删。）

  ⚠ 生产 IP 必须在这里出现，否则 release 包**连首页都加载不出来**：
  `app/build.gradle` 的 release 把 shell_entry 指向 http://106.55.27.246/b/，
  而 targetSdk 34 默认禁止明文 —— WebView 直接渲染
  `net::ERR_CLEARTEXT_NOT_PERMITTED`，一个 Java 异常都不会抛，
  Gradle 构建、签名、安装全部成功。这个坑咬过一次：release 包装上去是错误页，
  而 debug 包一切正常（10.0.2.2/localhost 本来就在白名单里），
  于是看起来像"打包出了问题"，实际是这份白名单少一行。

  为什么还在用 http：域名 hxmall.top 的备案未通过，443 上不去，
  只能走 IP + 明文。备案通过后应改成 https 并把这条 IP 删掉。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 生产（备案通过前的临时状态，见上） -->
        <domain includeSubdomains="false">106.55.27.246</domain>
        <!-- 本地调试：10.0.2.2 是模拟器访问宿主机 localhost 的固定地址 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
