# 正式签名的配置。**复制成同目录下的 keystore.properties 再填**，那一份永不进 git。
#
#   cp keystore.properties.example keystore.properties
#   vi keystore.properties          # 填下面五项
#   chmod 600 keystore.properties   # 密码在里面，别让同机其他账号读到
#   ../gen-release-keystore.sh      # 生成 keystore 并打印三个指纹
#
# 这份 .example 是给下一个人看的模板，**不要往里面填真密码** ——
# 它是被跟踪的文件，填了就等于把密码提交进了历史，而 git 历史删不干净。

# keystore 落在哪里。**放仓库外**：仓库会被 clone、被打包、被 CI 拉取，
# 而这把钥匙丢了或泄露了，这个包名就再也发不出可信的更新。
storeFile=/Users/你的用户名/keys/hxmall-release.jks

# keystore 密码与 key 密码。可以相同 —— 多数团队就是相同的，
# 分开保管的收益在这个规模下抵不过「记混了打不出包」的代价。
storePassword=
keyPassword=

# 别名。一个 keystore 可以放多把 key，用别名区分。
# 三端（安卓/iOS/鸿蒙）同一个应用建议共用一把，别名就写应用名。
keyAlias=hxmall

# 证书主体。**签发后不可改**，会永久显示在证书里。
# CN 用公司英文名 —— 应用商店与部分推送后台会展示它。
dname=CN=Shenzhen HongXuan Technology, O=Shenzhen HongXuan Technology Co. Ltd, L=Shenzhen, ST=Guangdong, C=CN

# 有效期（天）。10950 ≈ 30 年。
# **证书过期后无法再发布更新**，Google Play 要求至少覆盖到 2033 年 —— 宁长勿短。
validityDays=10950
