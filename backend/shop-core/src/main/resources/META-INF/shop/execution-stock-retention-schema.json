  "triggers": [
    {
      "name": "trg_esr_immutable",
      "table": "prd_execution_retention",
      "timing": "BEFORE",
      "event": "UPDATE",
      "body": "BEGIN\n    IF NOT (BINARY NEW.id <=> BINARY OLD.id) OR\n        NOT (BINARY NEW.tenant_no <=> BINARY OLD.tenant_no) OR\n        NOT (BINARY NEW.created_at <=> BINARY OLD.created_at) OR\n        NOT (BINARY NEW.created_by <=> BINARY OLD.created_by) OR\n        NOT (BINARY NEW.entity_no <=> BINARY OLD.entity_no) OR\n        NOT (BINARY NEW.store_no <=> BINARY OLD.store_no) OR\n        NOT (BINARY NEW.retention_no <=> BINARY OLD.retention_no) OR\n        NOT (BINARY NEW.execution_no <=> BINARY OLD.execution_no) OR\n        NOT (BINARY NEW.unit_no <=> BINARY OLD.unit_no) OR\n        NOT (BINARY NEW.grant_no <=> BINARY OLD.grant_no) OR\n        NOT (BINARY NEW.attempt_no <=> BINARY OLD.attempt_no) OR\n        NOT (BINARY NEW.reference_schema <=> BINARY OLD.reference_schema) OR\n        NOT (BINARY NEW.reference_json <=> BINARY OLD.reference_json) OR\n        NOT (BINARY NEW.reference_hash <=> BINARY OLD.reference_hash) OR\n        NOT (BINARY NEW.original_binding_bytes_hash <=> BINARY OLD.original_binding_bytes_hash) OR\n        NOT (BINARY NEW.prepared_grant_revision <=> BINARY OLD.prepared_grant_revision) OR\n        NOT (BINARY NEW.original_row_id <=> BINARY OLD.original_row_id) OR\n        NOT (BINARY NEW.original_lock_no <=> BINARY OLD.original_lock_no) OR\n        NOT (BINARY NEW.stock_original_json <=> BINARY OLD.stock_original_json) OR\n        NOT (BINARY NEW.original_hash <=> BINARY OLD.original_hash) OR\n        NOT (BINARY NEW.original_manifest_hash <=> BINARY OLD.original_manifest_hash) OR\n        NOT (BINARY NEW.confirmation_operation_no <=> BINARY OLD.confirmation_operation_no) OR\n        NOT (BINARY NEW.source_confirmation_no <=> BINARY OLD.source_confirmation_no) OR\n        NOT (BINARY NEW.original_row_version <=> BINARY OLD.original_row_version) OR\n        NOT (BINARY NEW.original_disposition <=> BINARY OLD.original_disposition) OR\n        NOT (BINARY NEW.original_row_json <=> BINARY OLD.original_row_json) OR\n        NOT (BINARY NEW.owner_set_hash <=> BINARY OLD.owner_set_hash) OR\n        NOT (BINARY NEW.owner_set_count <=> BINARY OLD.owner_set_count) OR\n        NOT (BINARY NEW.request_hash <=> BINARY OLD.request_hash) OR\n        NOT (BINARY NEW.resource_command_no <=> BINARY OLD.resource_command_no) OR\n        NOT (BINARY NEW.resource_command_hash <=> BINARY OLD.resource_command_hash) OR\n        NOT (BINARY NEW.plan_hash <=> BINARY OLD.plan_hash) OR\n        NOT (BINARY NEW.creator_namespace_hash <=> BINARY OLD.creator_namespace_hash) OR\n        NOT (BINARY NEW.creator_personnel_hash <=> BINARY OLD.creator_personnel_hash) OR\n        NOT (BINARY NEW.accepted_authority_json <=> BINARY OLD.accepted_authority_json) OR\n        NOT (BINARY NEW.accepted_authority_hash <=> BINARY OLD.accepted_authority_hash) THEN\n        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Execution stock retention immutable original';\n    END IF;\n    IF OLD.state='RELEASED_NO_EFFECT' AND (NEW.state<>OLD.state OR\n        NOT (BINARY NEW.no_effect_seal_json <=> BINARY OLD.no_effect_seal_json) OR\n        NOT (BINARY NEW.no_effect_seal_no <=> BINARY OLD.no_effect_seal_no) OR\n        NOT (NEW.no_effect_seal_revision <=> OLD.no_effect_seal_revision) OR\n        NOT (BINARY NEW.no_effect_seal_hash <=> BINARY OLD.no_effect_seal_hash)) THEN\n        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Retention seal is permanent';\n    END IF;\n    IF OLD.issue_observation_hash IS NOT NULL AND (\n        NOT (BINARY NEW.issue_observation_json <=> BINARY OLD.issue_observation_json) OR\n        NOT (BINARY NEW.issue_observation_hash <=> BINARY OLD.issue_observation_hash)) THEN\n        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Retention issue observation is immutable';\n    END IF;\nEND"
    },
    {
      "name": "trg_esr_no_delete",
      "table": "prd_execution_retention",
      "timing": "BEFORE",
      "event": "DELETE",
      "body": "BEGIN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Execution stock retention history cannot be deleted';\nEND"
    }
