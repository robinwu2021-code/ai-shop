        "ck_esr_base": "tenant_no='MAIN' AND version>=0 AND deleted=0",
        "ck_esr_scope": "CHAR_LENGTH(entity_no)>0 AND CHAR_LENGTH(store_no)>0",
        "ck_esr_revision": "attempt_no>0 AND prepared_grant_revision>0 AND original_row_id>0 AND original_row_version>=0 AND owner_set_count>0",
        "ck_esr_state": "state IN ('RETAINED','RELEASED_NO_EFFECT') AND original_disposition IN ('ALLOCATED','CONFIRMED')",
        "ck_esr_schema": "reference_schema='SERVICE_EXECUTION_REFERENCE_V1'",
        "ck_esr_hashes": "retention_no REGEXP '^[0-9a-f]{64}$' AND reference_hash REGEXP '^[0-9a-f]{64}$' AND original_binding_bytes_hash REGEXP '^[0-9a-f]{64}$' AND original_hash REGEXP '^[0-9a-f]{64}$' AND original_manifest_hash REGEXP '^[0-9a-f]{64}$' AND owner_set_hash REGEXP '^[0-9a-f]{64}$' AND request_hash REGEXP '^[0-9a-f]{64}$' AND resource_command_hash REGEXP '^[0-9a-f]{64}$' AND plan_hash REGEXP '^[0-9a-f]{64}$' AND creator_namespace_hash REGEXP '^[0-9a-f]{64}$' AND creator_personnel_hash REGEXP '^[0-9a-f]{64}$' AND accepted_authority_hash REGEXP '^[0-9a-f]{64}$' AND (issue_observation_hash IS NULL OR issue_observation_hash REGEXP '^[0-9a-f]{64}$') AND (no_effect_seal_hash IS NULL OR no_effect_seal_hash REGEXP '^[0-9a-f]{64}$')",
        "ck_esr_json": "JSON_VALID(reference_json) AND JSON_VALID(stock_original_json) AND JSON_VALID(original_row_json) AND JSON_VALID(accepted_authority_json) AND (issue_observation_json IS NULL OR JSON_VALID(issue_observation_json)) AND (no_effect_seal_json IS NULL OR JSON_VALID(no_effect_seal_json))",
        "ck_esr_issue": "(issue_observation_json IS NULL AND issue_observation_hash IS NULL) OR (issue_observation_json IS NOT NULL AND issue_observation_hash IS NOT NULL)",
        "ck_esr_seal": "(state='RETAINED' AND no_effect_seal_json IS NULL AND no_effect_seal_no IS NULL AND no_effect_seal_revision IS NULL AND no_effect_seal_hash IS NULL) OR (state='RELEASED_NO_EFFECT' AND no_effect_seal_json IS NOT NULL AND no_effect_seal_no IS NOT NULL AND no_effect_seal_revision>0 AND no_effect_seal_hash IS NOT NULL)"
