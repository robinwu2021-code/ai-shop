<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.shop</groupId>
        <artifactId>shop-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shop-app</artifactId>
    <packaging>jar</packaging>
    <description>启动模块：portal(三端 Controller) + config + 装配。单体形态依赖全部 svc。</description>

    <dependencies>
        <!-- 定时任务调度引擎。**业务实例内的 worker 用它**（J2/G2 阶段）——
             与独立 worker 跑的是同一套代码，「先在业务实例内跑通、观察一周、再拆出去」
             这条路上才不会变成两套各自演进的实现 -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-job-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ★ 这段依赖列表就是「形态」：单体聚合全部 svc；将来出 shop-app-trade 只留 trade 那几个 -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-merchant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-settle</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-inventory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-notify</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ⚠️ Boot 4 把自动配置按技术拆成独立模块：只加 flyway-core 迁移不会执行，
             且不报错（表数不变、无 flyway_schema_history），必须带 spring-boot-flyway。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ShedLock 的锁实现：只有启动模块知道连的是哪个库（注解在 shop-base） -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试用内存库：S0 只验证契约与装配，不验证 MySQL 方言 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              E2E 默认不跑：它依赖一个跑着的 MariaDB，没有数据库的机器上会红 ——
              而「构建在别人机器上红」会让人开始忽略红灯。
              跑法：mvn test -Pe2e
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 用属性而不是写死：空的 <excludedGroups/> 在 profile 合并时不会覆盖父值 -->
                    <groups>${surefire.groups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!-- 默认：跑全部非 e2e 的用例 -->
        <surefire.groups></surefire.groups>
        <surefire.excludedGroups>e2e</surefire.excludedGroups>
    </properties>

    <profiles>
        <profile>
            <id>e2e</id>
            <properties>
                <!-- 只跑 E2E：与快测分开，失败原因不会混在一起 -->
                <surefire.groups>e2e</surefire.groups>
                <surefire.excludedGroups></surefire.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>
