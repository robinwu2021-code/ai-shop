<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.shop</groupId>
        <artifactId>shop-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shop-app</artifactId>
    <packaging>jar</packaging>
    <description>启动模块：portal(三端 Controller) + config + 装配。单体形态依赖全部 svc。</description>

    <dependencies>
<dependency><groupId>ai.neargo.shop</groupId><artifactId>print-domain</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>ai.neargo.shop</groupId><artifactId>print-channel</artifactId><version>${project.version}</version></dependency>

        <!-- 定时任务调度引擎。**业务实例内的 worker 用它**（J2/G2 阶段）——
             与独立 worker 跑的是同一套代码，「先在业务实例内跑通、观察一周、再拆出去」
             这条路上才不会变成两套各自演进的实现 -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>job-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-store-mybatis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-base-auth</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ★ 这段依赖列表就是「形态」：单体聚合全部 svc；将来出 shop-app-trade 只留 trade 那几个 -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-merchant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>pay-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-inventory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 报表：独立库的持久层。日结「读交易域、写报表库」是跨域组合，
             按 ArchitectureTest 的规矩住在本模块（reportbridge 包），
             所以引它的是 shop-app，而不是 shop-report 反过来引 shop-core -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-report</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 元器件已迁到独立仓库 ai-hxkey（服务名 hxkey），主应用**不引它的代码**，只引零依赖的内部契约：
             给它开的 /internal/elec/** 与它那一侧的客户端用同一份路径与 record -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>elec-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>logistics-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>logistics-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 支付通道适配（2026-09-01 从 shop-channel 拆出）。
             **内嵌形态必须显式依赖它**：shop-app 不直接 import 这些类，
             只通过 spi 接口拿到 —— 所以少了这条依赖**编译照样过**，
             而运行时 PayQueryPort / 验签器 / 各 Gateway 的 bean 全部消失。 -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>pay-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-notify</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ⚠️ Boot 4 把自动配置按技术拆成独立模块：只加 flyway-core 迁移不会执行，
             且不报错（表数不变、无 flyway_schema_history），必须带 spring-boot-flyway。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ShedLock 的锁实现：只有启动模块知道连的是哪个库（注解在 shop-base）。
             版本在 backend/pom.xml 的 dependencyManagement（Boot BOM 不管它） -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试用内存库：S0 只验证契约与装配，不验证 MySQL 方言 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <!--
                      build-info：把版本与构建时刻写进 META-INF/build-info.properties，
                      Spring Boot 的 /actuator/info 会自动读它。
                      **为什么需要**：线上跑的是哪个提交，此前从外面问不出来 ——
                      2026-08-29 排查一个任务异常时为此反推了四轮，
                      而部署脚本切软链与进程重启是两件事，文件名对不代表进程在跑它。
                    -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <!--
                                  提交号由**部署脚本**用 -Dgit.sha= 传进来，不引额外插件
                                  （git-commit-id 不在本机 ~/.m2，而构建是离线的）。
                                  好处不只是省一个依赖：jar 文件名里的 SHA 与这里的 SHA
                                  **来自同一个变量**，天然不可能对不上。
                                  手工 mvn package 时它是 unknown —— 那也如实反映了
                                  「这个包不是走部署流程出来的」。
                                -->
                                <gitSha>${git.sha}</gitSha>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>



            <!--
              E2E 默认不跑：它依赖一个跑着的 MariaDB，没有数据库的机器上会红 ——
              而「构建在别人机器上红」会让人开始忽略红灯。
              跑法：mvn test -Pe2e
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Import the architecture graphs before the long-lived Spring context cache grows.
                         This keeps the same single test execution and -Dtest selection semantics;
                         graph fixtures release their references after their own rules finish. -->
                    <runOrder>alphabetical</runOrder>
                    <!-- 整套 shop-app 用例共用一个 H2 内存库并缓存多份 Spring 上下文，默认堆（物理内存 1/4）
                         在 16GB 机器上只有 4GB，全量跑到 Payment*/Points* 一带就 OutOfMemoryError ——
                         表现成几十条「Failed to load ApplicationContext」与 H2「database has been closed」。
                         按比例给而不是写死 -Xmx：内存小的机器不会因此被撑爆。 -->
                    <!-- 时区与生产一致（国内节点，Asia/Shanghai）。积分统计等按 JVM 本地时间落库、按北京营业日取数，
                         开发机在别的时区时每天有几个小时两边的「今天」不是同一天，相关用例就固定变红。 -->
                    <argLine>-XX:MaxRAMPercentage=40 -Duser.timezone=Asia/Shanghai</argLine>
                    <!-- 用属性而不是写死：空的 <excludedGroups/> 在 profile 合并时不会覆盖父值 -->
                    <systemPropertyVariables>
                        <food.build.shape>${food.build.shape}</food.build.shape>
                    </systemPropertyVariables>
                    <groups>${surefire.groups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!-- 默认：跑全部非 e2e 的用例 -->
        <food.build.shape>retail</food.build.shape>
        <git.sha>unknown</git.sha>
        <surefire.groups></surefire.groups>
        <surefire.excludedGroups>e2e</surefire.excludedGroups>
    </properties>

    <profiles>
        <!-- Each Surefire execution owns a fresh fork: close Spring contexts and release
             JVM/static caches between bounded batches. Override default-test rather than
             adding an unfiltered ninth run. A focused -Dtest uses the usual single run.
             Keep Surefire's four default naming conventions and nested-class exclusion. -->
        <profile>
            <id>bounded-test-batches</id>
            <activation><property><name>!test</name></property></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                        <execution>
                            <id>default-test</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=[A-Ca-c])(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-batch-d-f</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=[D-Fd-f])(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-batch-g-l</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=[G-Lg-l])(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-batch-m-n</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=[M-Nm-n])(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-batch-o</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=[Oo])(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-batch-p</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=[Pp])(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-batch-q-r</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=[Q-Rq-r])(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>test-batch-rest</id>
                            <phase>test</phase>
                            <goals><goal>test</goal></goals>
                            <configuration>
                                <includes><include>%regex[(?:.*/)?(?=(?:[S-Zs-z]|[^A-Za-z]))(?:Test[^/]*|[^/]*Test|[^/]*Tests|[^/]*TestCase)\.class]</include></includes>
                            </configuration>
                        </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 显式构建形态；运行时仍必须设置 shop.food.enabled/deployment。 -->
        <profile>
            <id>food-embedded</id>
            <properties>
                <food.build.shape>embedded</food.build.shape>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>ai.neargo.shop</groupId>
                    <artifactId>food-web</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>ai.neargo.shop</groupId>
                    <artifactId>food-core</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>food-embedded-native-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources><source>src/food-embedded-test/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 显式构建形态；运行时仍必须设置 shop.food.enabled/deployment。 -->
        <profile>
            <id>food-standalone</id>
            <properties>
                <food.build.shape>standalone</food.build.shape>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>ai.neargo.shop</groupId>
                    <artifactId>food-web</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>food-standalone-no-local-writer</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <bannedDependencies>
                                            <excludes>
                                                <exclude>ai.neargo.shop:food-core</exclude>
                                                <exclude>ai.neargo.shop:food-server</exclude>
                                            </excludes>
                                            <searchTransitive>true</searchTransitive>
                                        </bannedDependencies>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>e2e</id>
            <properties>
                <!-- 只跑 E2E：与快测分开，失败原因不会混在一起 -->
                <surefire.groups>e2e</surefire.groups>
                <surefire.excludedGroups></surefire.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>
