      "body": "BEGIN\n    IF NOT (BINARY NEW.id <=> BINARY OLD.id) OR\n        NOT (BINARY NEW.tenant_no <=> BINARY OLD.tenant_no) OR\n        NOT (BINARY NEW.entity_no <=> BINARY OLD.entity_no) OR\n        NOT (BINARY NEW.store_no <=> BINARY OLD.store_no) OR\n        NOT (BINARY NEW.execution_no <=> BINARY OLD.execution_no) OR\n        NOT (BINARY NEW.unit_no <=> BINARY OLD.unit_no) OR\n        NOT (BINARY NEW.grant_no <=> BINARY OLD.grant_no) OR\n        NOT (BINARY NEW.attempt_no <=> BINARY OLD.attempt_no) OR\n        NOT (BINARY NEW.prepared_grant_revision <=> BINARY OLD.prepared_grant_revision) OR\n        NOT (BINARY NEW.route_no <=> BINARY OLD.route_no) OR\n        NOT (BINARY NEW.route_hash <=> BINARY OLD.route_hash) OR\n        NOT (BINARY NEW.retention_no <=> BINARY OLD.retention_no) OR\n        NOT (BINARY NEW.request_hash <=> BINARY OLD.request_hash) OR\n        NOT (BINARY NEW.reference_hash <=> BINARY OLD.reference_hash) OR\n        NOT (BINARY NEW.parent_original_hash <=> BINARY OLD.parent_original_hash) OR\n        NOT (BINARY NEW.parent_manifest_hash <=> BINARY OLD.parent_manifest_hash) OR\n        NOT (BINARY NEW.stock_confirmation_operation_no <=> BINARY OLD.stock_confirmation_operation_no) OR\n        NOT (BINARY NEW.source_evidence_hash <=> BINARY OLD.source_evidence_hash) OR\n        NOT (BINARY NEW.component_roster_hash <=> BINARY OLD.component_roster_hash) OR\n        NOT (BINARY NEW.accepted_intent_no <=> BINARY OLD.accepted_intent_no) OR\n        NOT (BINARY NEW.accepted_intent_hash <=> BINARY OLD.accepted_intent_hash) OR\n        NOT (BINARY NEW.original_human_authority_hash <=> BINARY OLD.original_human_authority_hash) OR\n        NOT (BINARY NEW.resource_command_hash <=> BINARY OLD.resource_command_hash) OR\n        NOT (BINARY NEW.plan_hash <=> BINARY OLD.plan_hash) OR\n        NOT (BINARY NEW.route_schema <=> BINARY OLD.route_schema) OR\n        NOT (BINARY NEW.reference_schema <=> BINARY OLD.reference_schema) OR\n        NOT (BINARY NEW.frozen_authority <=> BINARY OLD.frozen_authority) OR\n        NOT (BINARY NEW.source_confirmation_no <=> BINARY OLD.source_confirmation_no) OR\n        NOT (BINARY NEW.resource_command_no <=> BINARY OLD.resource_command_no) OR\n        NOT (BINARY NEW.component_roster_count <=> BINARY OLD.component_roster_count) OR\n        NOT (BINARY NEW.route_json <=> BINARY OLD.route_json) OR\n        NOT (BINARY NEW.reference_json <=> BINARY OLD.reference_json) OR\n        NOT (BINARY NEW.parent_original_json <=> BINARY OLD.parent_original_json) OR\n        NOT (BINARY NEW.source_evidence_json <=> BINARY OLD.source_evidence_json) OR\n        NOT (BINARY NEW.component_roster_json <=> BINARY OLD.component_roster_json) OR\n        NOT (BINARY NEW.accepted_intent_json <=> BINARY OLD.accepted_intent_json) OR\n        NOT (BINARY NEW.original_human_authority_json <=> BINARY OLD.original_human_authority_json) OR\n        NOT (BINARY NEW.mirror_original_json <=> BINARY OLD.mirror_original_json) OR\n        NOT (BINARY NEW.mirror_original_hash <=> BINARY OLD.mirror_original_hash) OR\n        NOT (BINARY NEW.created_at <=> BINARY OLD.created_at) OR\n        NOT (BINARY NEW.created_by <=> BINARY OLD.created_by) OR\n        NOT (BINARY NEW.deleted <=> BINARY OLD.deleted) THEN\n        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Execution stock retention immutable original';\n    END IF;\n    IF OLD.state IN ('CONFLICT','RELEASE_PENDING','RELEASED_NO_EFFECT') AND NEW.state<>OLD.state THEN\n        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Retention route terminal state cannot reopen';\n    END IF;\n    IF NEW.revision<>OLD.revision+1 OR NEW.observation_epoch<>OLD.observation_epoch+1 OR\n        OLD.revision>=9223372036854775806 OR OLD.observation_epoch>=9223372036854775806 THEN\n        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Retention route observation CAS required';\n    END IF;\nEND"
