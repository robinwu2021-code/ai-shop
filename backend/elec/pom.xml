        <!-- 与主系统的内部契约：零依赖。主应用引它；**ai-hxkey 的 elec-svc 从本机 ~/.m2 引它**。
             元器件本体（elec-core、elec-svc、小程序）已迁到独立项目 ~/work/ai/ai-hxkey（2026-09-30）。
             改这里的 record 或路径常量 = 改两个仓库之间的契约：改完 mvn install，再到 ai-hxkey 跑全量测试 -->
        <module>elec-api</module>
    </modules>
</project>
