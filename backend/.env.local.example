# 后端本地环境变量模板。
#
# 用法：复制成 .env.local 填真值，再 source 进 shell（.env.local 已在 .gitignore 里）：
#   cp backend/.env.local.example backend/.env.local
#   set -a && source backend/.env.local && set +a
#
# ⚠️ **本文件入库，所以只能放非密值与说明；真正的密钥只写进 .env.local。**
#    application.yml 里对应的是 ${VAR:默认值} —— 非密项在那里已有默认值，
#    这里重复一份是为了本地能一眼看全要配哪些。

# ─────────────────────────────────────────────────────────────
# 短信（阿里云 dysmsapi）
# ─────────────────────────────────────────────────────────────
# 桩模式：true = 只打日志不真发。**默认 true 是有意的** ——
# 默认发真短信意味着本地跑一次测试就在花钱，且会真骚扰到测试手机号。
SHOP_SMS_STUB=true

# ⚠️ 开关只有 SHOP_SMS_STUB 一个（早期设计里还有个 ALI_SMS_ENABLED，已去掉——
#    两个开关意味着「配了却没生效」时要查两处）。
#    改成 false 之前必须确认发码限流开着（SHOP_OTP_RATE_LIMIT，默认 true）：
#    /mp/user/otp/send 是公网未鉴权端点，没限流 = 任何人循环调就能烧短信费。
#    stub=false 而 AK/SK/模板号缺任何一项时**直接起不来**，不静默退回桩。

ALI_SMS_SIGN=数智邻购
ALI_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 【密钥】不要填进这个模板文件
ALI_SMS_AK=
ALI_SMS_SK=

# 【必填】验证码短信的模板 CODE。账号里已报备通过的验证码模板有两个：
#   SMS_474945291「注册登录」验证码：${code}。您正在使用短信验证码登录功能，请勿转发或泄漏。
#   SMS_305059573「验证码短信」您的验证码为：${code}，请勿泄露于他人！
# 取前者：它明确写了「登录功能」，与 OTP 场景吻合。已实测发通（2026-08-13）。
ALI_SMS_TPL_OTP=SMS_474945291

# ─────────────────────────────────────────────────────────────
# 邮件（Office365 SMTP）· 消费方：运营端密码交付
# ─────────────────────────────────────────────────────────────
# 开关同样只有 SHOP_MAIL_STUB 一个。
SHOP_MAIL_STUB=true

MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=platform@neargo.ai

# ⚠️ **必须与 MAIL_USERNAME 一致**，除非在 M365 后台给发件账号授了
# 目标地址的「发送为（Send As）」权限。
# 实测（2026-08-13）：认证成功但投递被拒
#   554 5.2.252 SendAsDenied; platform@neargo.ai not allowed to send as system@neargo.ai
# 认证与发件权限是**两件事** —— 只测登录会以为通道没问题。
MAIL_FROM=platform@neargo.ai

# 【密钥】不要填进这个模板文件。
# ⚠️ 若该邮箱开了 MFA，普通密码不可用 —— 需要「应用密码」或改走 OAuth2。
MAIL_PASSWORD=

# 运营端初始密码的交付方式：
#   mail     = 邮件发给本人，接口不返回明文（默认，也是这次改造的目的）
#   response = 维持旧行为，接口返回明文由管理员转告
# 保留 response 是**逃生口**：邮件不通时若没有它，新建的账号永远没人能登录，
# 而那时管理员可能连一个能用的运营账号都没有。
SHOP_OPS_PASSWORD_DELIVERY=mail

# ─────────────────────────────────────────────────────────────
# 微信小程序：登录（code2Session）+ 订阅消息（服务通知）
# 一个开关管两件事：桩世界里 openid = wx.login 的 code（即接入前的既有行为），
# 切真通道后两者一起变真 —— 半真半假会缝合出「发给不存在的人」。
# ─────────────────────────────────────────────────────────────
SHOP_WX_STUB=true
WX_APPID=
# 【密钥】不要填进这个模板文件
WX_SECRET=
# developer / trial / formal。联调用 trial，免得打扰真实用户
WX_MP_STATE=formal
# mp 后台报备通过的模板号。**必须与端上 VITE_WX_TPL_* 同值** ——
# 不同值的话前端攒的订阅额度后端查不到，一条也发不出去。
# 桩世界用 STUB_TPL_ORDER_ARRIVED / STUB_TPL_REFUNDED，两端都有默认值，不用配。
WX_TPL_ORDER_ARRIVED=
WX_TPL_REFUNDED=

# ─────────────────────────────────────────────────────────────
# 微信支付（**普通直连商户号** · 小程序 JSAPI）
# 方案：docs/technical/design/TDD-微信支付直连商户号接入.md
#
# ⚠️ 全部在**微信商户平台**（pay.weixin.qq.com）取，需要超级管理员。
#    取的时候平台会让你扫码/输操作密码 —— 这几步没人能代劳。
#
# 显式开关。配了凭据不等于要启用（灰度、演练都可能只配不启）
WX_PAY_ENABLED=false
# direct = 普通直连商户号（本期）；ecommerce = 电商收付通服务商。
# **两套是不同的产品**，填错的表现是通道返回 NO_AUTH，看着像凭据配错
WX_PAY_MODE=direct
# 商户号（商户平台首页右上角，10 位数字）
WX_MCHID=
# 小程序 appid —— **刻意复用上面的 WX_APPID，不另起一个变量**。
# JSAPI 下单的 appid 必须就是与商户号绑定的那个小程序，
# 与登录/订阅消息用的是同一个。两个变量的话，改了一个忘了另一个，
# 症状是下单返回 APPID_MCHID_NOT_MATCH，而排查会去查商户平台的绑定关系。
#
# 商户 API 证书序列号（商户平台 → 账户中心 → API 安全 → API 证书）
WX_SERIAL_NO=
# 商户私钥 apiclient_key.pem 的**路径**（申请证书时下载，只给这一次）。
# 也可以用 WX_PRIVATE_KEY 直接给内容；两个都给时**以内容为准**
WX_PRIVATE_KEY_PATH=
# APIv3 密钥，32 位，自己设的（API 安全 → APIv3 密钥）。
# **设完平台不给看第二次**，自己留一份。回调解密用它
WX_APIV3_KEY=
# 微信支付公钥的路径（API 安全 → 微信支付公钥 → 下载）。验回调与验应答签名。
# 不配 = 不验签，启动时会打一条 WARN —— 别把它当成「验过了」
WX_PLATFORM_PUBLIC_KEY_PATH=
# 支付结果回调。必须 HTTPS 且公网可达，且 nginx 要转发这个前缀
# （deploy/tencent/nginx/www.hxmall.top.conf 已加，**改了要重新部署 nginx**）
WX_NOTIFY_URL=https://www.hxmall.top/callback/pay/channel/WECHAT

# ─────────────────────────────────────────────────────────────
# App 推送（uni-push 2.0 / 个推，ADR-018）· 先用免费档
# 在线消息（长连接）不限量；**厂商离线通道有日配额**，且高优先级（息屏响铃）
# 要按小米/华为/OPPO/vivo/荣耀逐家申请资质。配额用尽 → 留痕 FAILED → 站内信兜底。
# 三个值都在 uni-push（DCloud）控制台的应用详情里。
# ─────────────────────────────────────────────────────────────
SHOP_PUSH_STUB=true
GETUI_APP_ID=
GETUI_APP_KEY=
# 【密钥】不要填进这个模板文件
GETUI_MASTER_SECRET=

# ---------------------------------------------------------------- 高德 Web 服务（逆地理 / 地址校验 / 输入提示）
# 服务平台选「Web服务」。与 b-app 的 Android SDK key、运营端的 JS API key 都不是同一把。
# 不配时 /biz/geo/tips 返回空列表 —— 联想是加分项，不该把输入框卡住（见 b-app/src/utils/geo.ts）。
AMAP_WEB_KEY=
