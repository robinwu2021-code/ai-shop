<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.shop</groupId>
        <artifactId>shop-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>secret-core</artifactId>
    <packaging>jar</packaging>
    <description>密钥管理 · 信封加密（AES-256-GCM）、主密钥提供者、版本生命周期、轮换与到期任务</description>

    <!-- 「以库的形式内嵌在各进程，进程内解密」（表结构说明 §3.0）：这里不引 web，
         也不做成返回明文的远程服务 —— 那会让明文走网络。加密只用 JDK 自带的 javax.crypto。 -->
    <dependencies>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>secret-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>secret-store</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 到期与轮换任务实现 JobHandler（job-api 零依赖）；调度外壳在宿主 -->
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>job-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- secret-store 测试支撑可选指向真 MySQL（-Dsecret.mysql.url）；test-jar 不带传递的测试依赖，这里再声明一次 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>secret-store</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
