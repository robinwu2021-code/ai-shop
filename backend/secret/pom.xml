<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.shop</groupId>
        <artifactId>shop-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>secret-modules</artifactId>
    <packaging>pom</packaging>
    <description>平台级密钥管理三个模块的聚合 pom（目录分组，不是第二个父工程）</description>

    <!--
        与 job/pom.xml 同一条规矩：**这里只列模块**，property、dependency、dependencyManagement 一条都不放；
        子模块的 <parent> 直指 shop-parent。理由见 job/pom.xml。

        为什么是平台级而不在支付里（表结构说明 §3.0，完成度复核 D-5 / §6 Q1 已定）：
        物流、库存开放接口、通知都要调外部 API；放进支付，别的域要么复制一套，要么反向依赖支付。
        包名 ai.neargo.secret.*，与业务域分开 —— 它不认识任何业务概念，业务域依赖它，它不依赖业务域。
    -->
    <modules>
        <!-- 契约包：**零依赖**。业务域只依赖它（SecretVault / KeyRegistry / SecretRef / KeyPurpose） -->
        <module>secret-api</module>
        <!-- 持久层：sec_* 七张表的实体与 Mapper，及独立迁移目录 db/secret -->
        <module>secret-store</module>
        <!-- 信封加密、主密钥提供者、版本生命周期、轮换与到期任务 -->
        <module>secret-core</module>
    </modules>
</project>
