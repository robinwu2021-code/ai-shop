<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.shop</groupId>
        <artifactId>shop-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shop-channel</artifactId>
    <packaging>jar</packaging>
    <description>外部通道适配：支付 · 进件 · （后续）登录凭证 · 推送 · 上传</description>

    <!--
      为什么支付通道要从 settle 里分出来：**它不是结算逻辑，是外部适配**。
      微信、支付宝各自的报文格式、签名方式、回调协议，与「一笔钱怎么分」没有关系。

      部署上这个区分是硬需求（见 diagrams/deploy-topology.svg）：ops 部署只需要
      channel 的素材上传，不需要支付通道；混在 settle 里就没法按需装配。

      这里只装外部适配器，**不装业务判断** —— 一旦这里出现「这单该不该分账」，
      就说明有业务逻辑跟着报文格式跑了，换个通道要重写一遍。
    -->
    <dependencies>
        <dependency>
            <groupId>ai.neargo.shop</groupId>
            <artifactId>shop-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          邮件：JavaMailSender。Boot 的标准件，本地仓已有。

          ⚠️ **阿里云短信刻意不引官方 SDK**（com.aliyun:dysmsapi20170525）：
          本项目一律 `mvn -o` 离线构建，而那套 SDK 及其依赖树不在本地仓里 ——
          引进来会让每个人的构建当场挂掉，且报的是「找不到依赖」，
          与短信功能毫无关联。它的签名是 HMAC-SHA1 + 参数排序，用 JDK 自带的
          crypto 与 HttpClient 三十行写完，且已对着真实接口验证发通过。
        -->
        <!--
          直接用 jakarta.mail + angus 实现，**不引 spring-boot-starter-mail**：
          本地仓里 starter 只有 4.0.6，而 Boot BOM 要 4.0.7，离线构建当场解析失败。
          底层这两个本地都有，且我们只需要 Session + Transport，
          用不到 JavaMailSender 那层封装与它的自动配置。
        -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
            <version>2.1.5</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>2.0.5</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

</project>
