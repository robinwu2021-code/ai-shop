# 进销存独立服务的环境文件样例（执行方案 §二）。
# 放到 /data/app/neargo/inventory-<实例>/inventory.env，权限 600。**真实值不进仓库。**
#
# 生产分两套 = 两个库 + 两个应用实例；测试一套。下面三组只取其一。

# ── 生产 · 设备套（neargo-inventory@device）──────────────────────────────
INVENTORY_INSTANCE_CODE=DEVICE
INVENTORY_INSTANCE_ALLOWED_SYSTEMS=SHAREHUB,CHARGING
INVENTORY_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/neargo_inv_device?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
INVENTORY_DATASOURCE_USERNAME=neargo_inv_device
INVENTORY_DATASOURCE_PASSWORD=
SERVER_PORT=8087

# ── 生产 · 电商套（neargo-inventory@shop）────────────────────────────────
# 库是商城今天内嵌直连的那个，原地升级（不搬数据）
# INVENTORY_INSTANCE_CODE=SHOP
# INVENTORY_INSTANCE_ALLOWED_SYSTEMS=SHOP
# INVENTORY_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/ai_shop_inv?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# INVENTORY_DATASOURCE_USERNAME=neargo_inv_shop
# INVENTORY_DATASOURCE_PASSWORD=
# SERVER_PORT=8086

# ── 测试（neargo-inventory@test，一套装下全部业态）──────────────────────
# INVENTORY_INSTANCE_CODE=TEST
# INVENTORY_INSTANCE_ALLOWED_SYSTEMS=SHOP,SHAREHUB,CHARGING
# INVENTORY_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/inventory_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# INVENTORY_DATASOURCE_USERNAME=inventory_test
# INVENTORY_DATASOURCE_PASSWORD=
# SERVER_PORT=8086

# 只绑回环：同机内网直连，不经 nginx 对外
SERVER_ADDRESS=127.0.0.1
