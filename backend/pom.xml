<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 站在 neargo 地基上（TDD-backend §2）：继承 neargo-parent → Java 21 + Spring Boot 4.0.x
         + maven-enforcer(锁 JDK21) + MyBatis-Plus BOM + neargo commons 版本管理。
         relativePath 留空 → 从本机 ~/.m2 解析。 -->
    <parent>
        <groupId>ai.neargo</groupId>
        <artifactId>neargo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>ai.neargo.shop</groupId>
    <artifactId>shop-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>shop-parent</name>
    <description>社区电商 ai-shop 服务端 · 模块化单体（TDD-backend §4）</description>

    <!-- 模块数 = 未来可能的部署单元数；域数 = 包数（TDD-backend §4.1） -->
    <modules>
        <!-- 鉴权持久层：会话与登录日志。**不依赖 shop-base**（那会拖来 MyBatis），
             也不认识 Realm —— 它只为「一个命名的令牌池」存会话。
             依赖方向：shop-auth-store ← shop-base，无环 -->
        <module>shop-auth-store</module>
        <!-- 定时任务契约：**零依赖**（连 Spring 都不引）。
             业务侧实现 JobHandler，worker 只认名字。
             不放进 shop-base 的理由见它自己的 pom 注释 —— 一句话：
             shop-base 会把 mybatis-plus 拖给每一个引用者，而 worker 要的正是干净 -->
        <module>shop-job-api</module>
        <!-- 定时任务持久层：独立库 + JdbcClient 手写 SQL。
             不引 Spring Data（代理是 native 的负担），不引 shop-base（会拖来 MyBatis） -->
        <module>shop-job-store</module>
        <!-- 定时任务调度引擎：注册表/执行器/同步。**两个宿主共用** ——
             独立 worker 与业务实例内的 worker。抽出来是为了「先在业务实例内跑通、
             观察一周、再拆出去」这条路上两边跑的是同一套代码 -->
        <module>shop-job-core</module>
        <!-- 定时任务调度器：**独立可部署单元**，不含任何业务代码。
             没有 starter-web 是有意的（运营端读库不调它），HTTP 客户端用 JDK 自带的 -->
        <module>shop-job</module>
        <!-- 地基：横切基础设施 + 跨域契约。零业务依赖，谁都能依赖 -->
        <module>shop-base</module>
        <!-- 持久层的 MyBatis 实现。**排在 shop-base 之后、业务域之前** —— 它依赖前者、被后者依赖 -->
        <module>shop-store-mybatis</module>
        <!-- 鉴权与 web 接入。层序：内核 ← auth ← web -->
        <module>shop-base-auth</module>
        <!-- 领域服务实现（jar，不可独立启动） -->
        <!-- 核心域合并为一个工程：模块数 = 未来可能的部署单元数，域数 = 包数 -->
        <module>shop-core</module>
        <!-- 独立成工程的两个域：变更节奏与外部依赖都与核心域不同，最可能先拆微服务 -->
        <module>shop-merchant</module>
        <!-- 支付通道适配。2026-09-01 从 shop-channel 拆出 —— 通道是支付域的核心能力 -->
        <module>pay/pay-channel</module>
        <module>pay/pay-domain</module>
        <!-- 独立部署形态（形态 B）。今天装得起来但不接流量 —— 见 PayApplication 的类注释 -->
        <module>pay/pay-svc</module>
        <!-- 进销存：**独立数据源与独立迁移历史**（db/inventory），将来可独立交付。
             与 settle/merchant 同级的理由不同 —— 那两个是「变更节奏不同」，
             这个是「数据边界不同」：它的表不在 ai_shop 里 -->
        <module>shop-inventory</module>
        <!-- 外部通道适配：只装适配器，不装业务判断 -->
        <module>shop-channel</module>
        <!-- 触达中台：短信/邮件/微信订阅/聚合推送/平台直连推送 通道适配 -->
        <module>shop-notify</module>
        <!-- 启动模块：portal(三端 Controller) + config + 装配 -->
        <module>shop-app</module>
    </modules>

    <!-- neargo-parent 与 Spring Boot BOM 管不到的那几个，版本一律钉在这里。

         **为什么不许写在模块 pom 里**：ehcache 此前在 shop-base 与 shop-auth-store
         各写了一份 3.12.0。两处今天相同，明天只改一处 —— 而 Maven 不会报任何错，
         同一个 classpath 上两个版本按最近者胜，症状是「本机跑得起来、换台机器行为不同」。
         收编之后模块 pom 里不再出现字面量版本，`依赖清单.md` §1.2 就是这条的量具：
         那一节非空即代表有人又写回去了。 -->
    <properties>
        <archunit.version>1.3.0</archunit.version>
        <flyway.version>11.14.1</flyway.version>
        <shedlock.version>6.9.0</shedlock.version>
        <ehcache.version>3.12.0</ehcache.version>
        <cos.version>5.6.245</cos.version>
        <jakarta-mail.version>2.1.5</jakarta-mail.version>
        <angus-mail.version>2.0.5</angus-mail.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-mysql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <!-- Ehcache 3：会话缓存。**classifier 必须是 jakarta** —— 默认包用的是
                 javax.cache，Spring Boot 4 下连 CacheManager 都装配不起来，
                 而报错是 NoClassDefFoundError: javax/cache/…，看不出是 classifier 选错了。
                 **这里的 classifier 不是给引用方省事的，是让这条管理项匹配得上**：
                 dependencyManagement 按 groupId:artifactId:type:classifier 匹配，
                 两边都写 jakarta 才配得上，所以引用方那一侧的 classifier 仍要留着。 -->
            <dependency>
                <groupId>org.ehcache</groupId>
                <artifactId>ehcache</artifactId>
                <version>${ehcache.version}</version>
                <classifier>jakarta</classifier>
            </dependency>
            <!-- 腾讯云 COS：对象存储（CosMediaStore，生产用；本地磁盘作兜底） -->
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>${cos.version}</version>
            </dependency>
            <!-- 邮件：jakarta.mail + angus，不引 spring-boot-starter-mail
                 （本项目 `mvn -o` 离线构建，官方 SDK 的依赖树不在本地仓） -->
            <dependency>
                <groupId>jakarta.mail</groupId>
                <artifactId>jakarta.mail-api</artifactId>
                <version>${jakarta-mail.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.angus</groupId>
                <artifactId>angus-mail</artifactId>
                <version>${angus-mail.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
