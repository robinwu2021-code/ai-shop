<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 站在 neargo 地基上（TDD-backend §2）：继承 neargo-parent → Java 21 + Spring Boot 4.0.x
         + maven-enforcer(锁 JDK21) + MyBatis-Plus BOM + neargo commons 版本管理。
         relativePath 留空 → 从本机 ~/.m2 解析。 -->
    <parent>
        <groupId>ai.neargo</groupId>
        <artifactId>neargo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>ai.neargo.shop</groupId>
    <artifactId>shop-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>shop-parent</name>
    <description>社区电商 ai-shop 服务端 · 模块化单体（TDD-backend §4）</description>

    <!-- 模块数 = 未来可能的部署单元数；域数 = 包数（TDD-backend §4.1） -->
    <modules>
        <!-- 鉴权持久层：会话与登录日志。**不依赖 shop-base**（那会拖来 MyBatis），
             也不认识 Realm —— 它只为「一个命名的令牌池」存会话。
             依赖方向：shop-auth-store ← shop-base，无环 -->
        <module>shop-auth-store</module>
        <!-- 定时任务契约：**零依赖**（连 Spring 都不引）。
             业务侧实现 JobHandler，worker 只认名字。
             不放进 shop-base 的理由见它自己的 pom 注释 —— 一句话：
             shop-base 会把 mybatis-plus 拖给每一个引用者，而 worker 要的正是干净 -->
        <module>shop-job-api</module>
        <!-- 定时任务持久层：独立库 + JdbcClient 手写 SQL。
             不引 Spring Data（代理是 native 的负担），不引 shop-base（会拖来 MyBatis） -->
        <module>shop-job-store</module>
        <!-- 定时任务调度引擎：注册表/执行器/同步。**两个宿主共用** ——
             独立 worker 与业务实例内的 worker。抽出来是为了「先在业务实例内跑通、
             观察一周、再拆出去」这条路上两边跑的是同一套代码 -->
        <module>shop-job-core</module>
        <!-- 定时任务调度器：**独立可部署单元**，不含任何业务代码。
             没有 starter-web 是有意的（运营端读库不调它），HTTP 客户端用 JDK 自带的 -->
        <module>shop-job</module>
        <!-- 地基：横切基础设施 + 跨域契约。零业务依赖，谁都能依赖 -->
        <module>shop-base</module>
        <!-- 持久层的 MyBatis 实现。**排在 shop-base 之后、业务域之前** —— 它依赖前者、被后者依赖 -->
        <module>shop-store-mybatis</module>
        <!-- 鉴权与 web 接入。层序：内核 ← auth ← web -->
        <module>shop-base-auth</module>
        <!-- 领域服务实现（jar，不可独立启动） -->
        <!-- 核心域合并为一个工程：模块数 = 未来可能的部署单元数，域数 = 包数 -->
        <module>shop-core</module>
        <!-- 独立成工程的两个域：变更节奏与外部依赖都与核心域不同，最可能先拆微服务 -->
        <module>shop-merchant</module>
        <!-- 支付通道适配。2026-09-01 从 shop-channel 拆出 —— 通道是支付域的核心能力 -->
        <module>pay/pay-channel</module>
        <module>pay/pay-domain</module>
        <!-- 独立部署形态（形态 B）。今天装得起来但不接流量 —— 见 PayApplication 的类注释 -->
        <module>pay/pay-svc</module>
        <!-- 进销存：**独立数据源与独立迁移历史**（db/inventory），将来可独立交付。
             与 settle/merchant 同级的理由不同 —— 那两个是「变更节奏不同」，
             这个是「数据边界不同」：它的表不在 ai_shop 里 -->
        <module>shop-inventory</module>
        <!-- 外部通道适配：只装适配器，不装业务判断 -->
        <module>shop-channel</module>
        <!-- 触达中台：短信/邮件/微信订阅/聚合推送/平台直连推送 通道适配 -->
        <module>shop-notify</module>
        <!-- 启动模块：portal(三端 Controller) + config + 装配 -->
        <module>shop-app</module>
    </modules>

    <!-- 第三方版本的三条规矩（2026-09-06 复核后改写，此前这段话有三处与事实相反）：

         1. **Spring Boot BOM 已管的，这里不写。** 继承链 shop-parent → neargo-parent →
            spring-boot-starter-parent 把 BOM 的 dependencyManagement 一路带下来：ehcache（含
            jakarta classifier）、jakarta.mail、angus-mail、flyway 都在里面，模块只写 g:a，
            版本随 Boot 走。真要偏离 BOM，用 BOM **自己的属性名**覆盖（如 ehcache3.version）
            并在这里写明原因 —— 别新起一个属性名（只覆盖到一条、家族其余成员留在旧版本），
            更别用 BOM 的属性名却不知道（jakarta-mail.version / angus-mail.version 曾在这里
            以「BOM 管不到」为名出现，实际把 BOM 里十个 org.eclipse.angus 条目全钉住了）。
         2. **BOM 不管的，钉在下面的 dependencyManagement。** 今天只有 archunit、cos_api 与 shedlock
            （flyway 曾以 BOM 的属性名 flyway.version 钉在这里，值与 BOM 相同，Boot 4.1 起会把
            Flyway 静默留在 11.14.1 —— 同一次一并撤掉）。
         3. **模块 pom 里不写任何版本**，字面量与 ${...} 都不写（内部模块的 ${project.version} 除外）。
            为什么：模块里写的版本在 shop-app 里**根本不生效** —— 根工程继承的 BOM 会覆盖
            传递依赖声明的版本。此前 shop-base 写着 ehcache 3.12.0，fat jar 与线上装的一直是
            BOM 的 3.11.1；模块各自的测试跑一个版本、发布物跑另一个，台台机器都一样，
            Maven 一个字不报。

         闸门：scripts/gen-glossary.mjs 扫到模块 pom 里出现版本就直接失败
         （连模块级 dependencyManagement 一起扫；`依赖清单.md` §1.2 因此永远为空）。 -->
    <properties>
        <archunit.version>1.3.0</archunit.version>
        <shedlock.version>6.9.0</shedlock.version>
        <cos.version>5.6.245</cos.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- 以下三条 Boot BOM 不管，版本只在这里出现（用途见各引用方自己的注释） -->
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>${cos.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
