<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.shop</groupId>
        <artifactId>shop-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shop-base</artifactId>
    <packaging>jar</packaging>
    <description>地基：横切基础设施（common · auth · event · idem）+ 跨域契约（spi 的 Port/DTO/Event）</description>

    <!--
      由 shop-common 与 shop-spi 合并而来（模块优化实施步骤 S6）。

      合并前担心的是「spi 是纯接口、零依赖，合进来会让契约能引用基础设施类型」——
      核对后发现 **shop-spi 本来就依赖 shop-common**（Port 的事件契约直接 import
      ai.neargo.shop.event.DomainEvent）。那条编译期保证从来不存在，
      合并因此不损失任何东西，只少一个 pom。

      包结构保持不变：common / auth / event / idem 是基础设施，spi 是跨域契约，
      两者的边界仍由 ArchitectureTest 的 commonMustNotDependOnDomains 与
      portInterfacesOnlyInSpi 看着。
    -->
    <dependencies>
        <!-- neargo L1 纯库（IdGenerator/ErrorCode 等），不含 autoconfig -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-core</artifactId>
        </dependency>
        <!-- 复用 neargo RBAC（@perm/PermissionCarrier/Permissions）。
             其 SecurityAutoConfiguration/SessionStoreAutoConfiguration 在 app 层 exclude 掉（TDD-backend §2.1-3）。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-security</artifactId>
        </dependency>
        <!-- 复用 neargo 数据权限引擎（scope 包）：DataScopeSpec/Context/Handler/TableRegistry。
             其 DataAutoConfiguration 同样在 app 层 exclude。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-data</artifactId>
        </dependency>

        <!-- ⚠️ Boot4 starter 不传递 extension（分页/乐观锁拦截器在里面），必须显式引；
             jsqlparser 是 DataScopeHandler 拼 where 的依赖（TDD-backend §2.1-2）。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            ShedLock：定时任务的分布式锁。放在 shop-base 而不是 shop-app，
            因为 @SchedulerLock 标在各域自己的 Job 上（shop-merchant / shop-settle），
            注解要在它们的编译期可见；**锁的实现（JdbcTemplate provider）在 shop-app**，
            那里才知道连的是哪个库 —— 域模块不该知道。
            版本不由 neargo-parent 管理，显式钉住。
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>${shedlock.version}</version>
        </dependency>

        <!--
            Ehcache 3：会话的**单机持久化**形态（shop.auth.token-store=ehcache）。
            classifier 必须是 jakarta —— 默认包用的是 javax.cache，Spring Boot 4 下
            连 CacheManager 都装配不起来，而报错信息是 NoClassDefFoundError: javax/cache/...，
            看不出是 classifier 选错了。
            版本不由 neargo-parent 管理，这里显式钉住。
        -->
        <dependency>
            <groupId>org.ehcache</groupId>
            <artifactId>ehcache</artifactId>
            <version>3.12.0</version>
            <classifier>jakarta</classifier>
        </dependency>
    </dependencies>

</project>
