# 后端 API「源」（端点路径自带 /ops 前缀，见 lib/api/https/*）：
#  - 同源 nginx 反代（生产）：留空 → 同源请求 /ops/**
#  - 跨源本地开发：填后端源，如 http://localhost:8080
NEXT_PUBLIC_API_BASE=

# 1=内存 mock（默认，无后端即可跑全站）；0=真实后端
NEXT_PUBLIC_USE_MOCK=1

# 产品分期门禁：1=一期(P0) 2=二期(P1) 3=增强(P2)。改后需重启 dev server。
NEXT_PUBLIC_CURRENT_PHASE=1

# 子路径部署（如 /ai-shop/ops-web），留空为根路径
NEXT_PUBLIC_BASE_PATH=
