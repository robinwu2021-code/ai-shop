# 后端 API「源」（端点路径自带 /ops 前缀，见 lib/api/https/*）：
#  - 同源 nginx 反代（生产）：留空 → 同源请求 /ops/**
#  - 跨源本地开发：填后端源，如 http://localhost:8080
NEXT_PUBLIC_API_BASE=
# OpsKit 审批的同源绝对路径。空 = /ops/opskit/v1（或拼接统一 API 的同源前缀）。
NEXT_PUBLIC_OPSKIT_API_BASE=
# 电子元器件服务（elec-svc，/elec/ops/**）的基址。生产同域留空；本机开发填 elec-svc 的地址（默认 http://127.0.0.1:8085），
# 并在 elec-svc 那边配 ELEC_DEV_CORS_ORIGINS=http://localhost:3100 放行运营端的源（生产不配）

# 1=内存 mock（默认，无后端即可跑全站）；0=真实后端
NEXT_PUBLIC_USE_MOCK=1

# 产品分期门禁：1=一期(P0) 2=二期(P1) 3=增强(P2)。改后需重启 dev server。
NEXT_PUBLIC_CURRENT_PHASE=1

# 子路径部署（如 /ai-shop/ops-web），留空为根路径
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------- 高德 JS API（小区裁决页的地图）
# 服务平台选「Web端(JS API)」。与 Android SDK key、后端 AMAP_WEB_KEY 都不是同一把。
# 安全密钥是必须的：2021-12 之后申请的 key 只填 key 不填密钥，地图不报错而是
# **一片空白**，控制台里才有 INVALID_USER_SCODE（见 lib/amap.ts）。
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_JS_SECURITY_CODE=

# 支付运营端的公开地址与登录提示；留空时沿用应用默认地址/提示，不含凭据。
NEXT_PUBLIC_NEARPAY_OPS_URL=
NEXT_PUBLIC_NEARPAY_LOGIN_HINT=
# 支付运营入口的权限探测（同源；有效权限非空才在顶栏显示「支付运营」）。空 = /oms-api/pay-ops/v2/me/access
NEXT_PUBLIC_NEARPAY_ACCESS_URL=

# 品牌兜底（运行时以 /ops-shop/brand.json 为准，见 TDD-ops-品牌名称与登录页）。空 = NearGo平台运营 / N / 生产
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_MARK=
# test | staging | 空（生产，不显示环境标签）
NEXT_PUBLIC_BRAND_ENV=

# 支付中心（near-pay 运营接口）的同源基址。空 = /oms-api/pay-ops/v2（nginx 直连 near-pay）；只收同源绝对路径（见 app/payment-center/_api/client.ts）
# 经 ai-shop 网关透传时（TDD-支付运营端经网关转发与权限下沉）：v2 填 /ops-shop-v2/ops/pay-ops/v2；本机要连真后端时须有同源反代（本项目 next.config 没有配）
NEXT_PUBLIC_PAY_OPS_API_BASE=
# 支付中心「API 清单 / 调用模拟」用的开放 API 对外基址（只收 https）；空 = https://tpay.neargo.ai/openapi/v1（UME 生产），签名 PATH 取它的路径部分
NEXT_PUBLIC_OPEN_API_BASE=
