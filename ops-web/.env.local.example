# 后端 API「源」（端点路径自带 /ops 前缀，见 lib/api/https/*）：
#  - 同源 nginx 反代（生产）：留空 → 同源请求 /ops/**
#  - 跨源本地开发：填后端源，如 http://localhost:8080
NEXT_PUBLIC_API_BASE=

# 1=内存 mock（默认，无后端即可跑全站）；0=真实后端
NEXT_PUBLIC_USE_MOCK=1

# 产品分期门禁：1=一期(P0) 2=二期(P1) 3=增强(P2)。改后需重启 dev server。
NEXT_PUBLIC_CURRENT_PHASE=1

# 子路径部署（如 /ai-shop/ops-web），留空为根路径
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------- 高德 JS API（小区裁决页的地图）
# 服务平台选「Web端(JS API)」。与 Android SDK key、后端 AMAP_WEB_KEY 都不是同一把。
# 安全密钥是必须的：2021-12 之后申请的 key 只填 key 不填密钥，地图不报错而是
# **一片空白**，控制台里才有 INVALID_USER_SCODE（见 lib/amap.ts）。
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_JS_SECURITY_CODE=
